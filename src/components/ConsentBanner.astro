---
import Icon from '@/components/Icon.astro';
/**
 * Cookie-/Consent-Banner (DSGVO/GDPR-konform).
 * Grundsatz: Vor Einwilligung wird NICHTS Externes geladen (keine Karte, keine Bewertungs-Widgets,
 * kein Tracking) – „block by default". Erst nach „Alle akzeptieren" wird das Event `belium:consent`
 * mit granted=true gefeuert, auf das die entsprechenden Komponenten hören.
 * Gleichwertige Buttons (Ablehnen so einfach wie Akzeptieren), keine Vorauswahl, kein Auto-Schließen.
 * Auswahl wird in localStorage gespeichert; jederzeit widerrufbar über das gebrandete Cookie-Widget.
 */
---
<div
  id="consent-banner"
  class="consent"
  role="dialog"
  aria-modal="false"
  aria-label="Hinweis zum Datenschutz"
  hidden
>
  <div class="consent__inner container-page">
    <div class="consent__text">
      <p class="consent__title">Wir respektieren deine Privatsphäre</p>
      <p class="consent__body">
        Diese Website lädt standardmäßig keine externen Dienste. Nur mit deiner Einwilligung binden wir
        Karte, Bewertungen und Statistik ein. Mehr dazu in der
        <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
    </div>
    <div class="consent__actions">
      <button type="button" class="btn btn-dark consent__btn" data-consent="essential">
        Nur notwendige
      </button>
      <button type="button" class="btn btn-primary consent__btn" data-consent="all">
        Alle akzeptieren
      </button>
    </div>
  </div>
</div>

<!-- Gebrandetes Cookie-Widget: jederzeitiger Zugriff auf die Einstellungen (Widerruf) -->
<button type="button" id="consent-widget" class="consent-widget" aria-label="Cookie-Einstellungen öffnen" hidden>
  <Icon name="cookie" class="w-6 h-6" />
</button>

<style>
  .consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    background: #fff;
    border-top: 1px solid var(--color-sand-deep);
    box-shadow: var(--shadow-float);
    animation: consent-up 0.4s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .consent { animation: none; }
  }
  @keyframes consent-up {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  .consent__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 1.1rem;
  }
  .consent__title { font-weight: 800; margin-bottom: 0.2rem; }
  .consent__body { font-size: 0.92rem; color: var(--color-ink-soft); }
  .consent__body a { color: var(--color-gold-deep); text-decoration: underline; }
  .consent__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .consent__btn { flex: 1 1 auto; }

  /* Gebrandetes Cookie-Widget (rund, Gold – passend zum Marken-Look) */
  .consent-widget {
    position: fixed; left: 1rem; bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 85; width: 3.1rem; height: 3.1rem; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--gradient-gold); color: #2a1c07; border: 0; cursor: pointer;
    box-shadow: var(--shadow-gold);
    transition: transform 0.2s cubic-bezier(0.22,1,0.36,1), box-shadow 0.2s ease;
  }
  .consent-widget:hover { transform: translateY(-2px) rotate(-6deg); box-shadow: 0 18px 40px -14px rgba(169,116,31,0.65); }
  .consent-widget:focus-visible { outline: 3px solid var(--color-gold); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .consent-widget:hover { transform: none; } }
  @media (min-width: 860px) {
    .consent__inner { flex-direction: row; align-items: center; justify-content: space-between; }
    .consent__text { max-width: 60ch; }
    .consent__actions { flex: 0 0 auto; }
    .consent__btn { flex: 0 0 auto; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'belium-consent-v1';
    var banner = document.getElementById('consent-banner');
    var widget = document.getElementById('consent-widget');

    function showWidget(show) {
      if (widget) widget.hidden = !show;
    }

    function apply(value) {
      window.__beliumConsent = value; // 'all' | 'essential'
      var granted = value === 'all';
      // Event, auf das Karte/Bewertungen/Tracking hören
      window.dispatchEvent(new CustomEvent('belium:consent', { detail: { granted: granted, value: value } }));
    }

    function store(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      apply(value);
      if (banner) banner.hidden = true;
      showWidget(true);
    }

    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) {}

    if (saved) {
      apply(saved);
      showWidget(true);
    } else if (banner) {
      banner.hidden = false;
    }

    document.querySelectorAll('[data-consent]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        store(btn.getAttribute('data-consent'));
      });
    });

    // Widerruf/erneutes Öffnen – über das Cookie-Widget (oder window.openConsent von anderswo)
    window.openConsent = function () {
      if (banner) banner.hidden = false;
      showWidget(false);
    };
    if (widget) widget.addEventListener('click', window.openConsent);
  })();
</script>
