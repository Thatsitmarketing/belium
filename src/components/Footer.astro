---
import { site, telLink, whatsappLink } from '@/data/site';
import Icon from '@/components/Icon.astro';
import Wordmark from '@/components/Wordmark.astro';
import Atmosphere from '@/components/Atmosphere.astro';
const year = 2026;
---
<footer class="footer">
  <Atmosphere tone="dark" opacity={0.3} class="footer__atmo" />

  <!-- Marken-Band -->
  <div class="container-page footer__top">
    <div class="footer__brand">
      <Wordmark size="lg" class="footer__wm" />
      <p class="footer__statement">Dauerhaft glatte Haut.<br /><span class="text-gold--on-dark">Ganz ohne Rasieren.</span></p>
    </div>
    <div class="footer__brand-right">
      <p class="footer__brand-note">Studio für dauerhafte Laser Haarentfernung mit gekühltem VIKINI&nbsp;Diodenlaser – mitten in Gelsenkirchen&nbsp;Buer.</p>
      <div class="footer__social">
        <a href={site.social.instagram} target="_blank" rel="noopener me" aria-label="Instagram"><Icon name="instagram" class="w-5 h-5" /></a>
        <a href={site.social.facebook} target="_blank" rel="noopener me" aria-label="Facebook"><Icon name="facebook" class="w-5 h-5" /></a>
      </div>
    </div>
  </div>

  <hr class="gold-hairline footer__rule" />

  <div class="container-page footer__grid">
    <div class="footer__col footer__col--wide">
      <h2 class="footer__h">Kontakt</h2>
      <address class="footer__addr">
        {site.address.street}<br />
        {site.address.zip} {site.address.city} {site.address.district}<br />
        <a href={telLink()} data-track="telefon_klick">{site.contact.phone}</a><br />
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </address>
      <a href={whatsappLink()} class="footer__wa" target="_blank" rel="noopener" data-track="whatsapp_klick">
        <Icon name="whatsapp" class="w-4 h-4" /> Per WhatsApp schreiben
      </a>
    </div>

    <nav class="footer__col" aria-label="Weitere Seiten">
      <h2 class="footer__h">Seite</h2>
      <ul class="footer__links">
        <li><a href="/#vorteile">Vorteile</a></li>
        <li><a href="/#ueber-maria">Über Maria</a></li>
        <li><a href="/#ablauf">Ablauf</a></li>
        <li><a href="/#preise">Preise</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a href="/#kontakt">Kontakt</a></li>
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Rechtliches">
      <h2 class="footer__h">Rechtliches</h2>
      <ul class="footer__links">
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
      </ul>
    </nav>
  </div>

  <div class="container-page footer__bottom">
    <p>© {year} {site.name}. Alle Rechte vorbehalten.</p>
    <p class="footer__note">Inhaberin: {site.owner}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative; z-index: 1; isolation: isolate; overflow: hidden;
    background: var(--color-ink);
    color: color-mix(in srgb, var(--color-cream) 80%, transparent);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-bottom: calc(2.5rem + env(safe-area-inset-bottom));
    /* Dezente Rundung am oberen Rand (Overlap-Effekt bleibt, aber zurückhaltender) */
    border-radius: clamp(1rem, 2.5vw, 1.75rem) clamp(1rem, 2.5vw, 1.75rem) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent);
    /* Der Footer schiebt sich als abgerundete Fläche über den Abschnitt darüber –
       dessen Hintergrund bleibt in den Rundungen sichtbar und wirkt „dahinter liegend". */
    margin-top: calc(-1 * clamp(2rem, 5vw, 4rem));
    box-shadow: 0 -30px 60px -34px rgba(8, 5, 3, 0.6);
  }
  .footer :global(.footer__atmo) { z-index: -1; }
  .footer > .container-page { position: relative; z-index: 1; }
  @media (min-width: 1024px) { .footer { padding-bottom: 2.75rem; } }

  /* Marken-Band */
  .footer__top { display: grid; grid-template-columns: 1fr; gap: 1.8rem; align-items: end; }
  @media (min-width: 900px) { .footer__top { grid-template-columns: 1.1fr 0.9fr; } }
  .footer :global(.footer__wm) { color: #fff; }
  .footer__statement {
    margin-top: 1.1rem; font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem); line-height: 1.08; color: #fff;
  }
  .footer__brand-right { display: flex; flex-direction: column; gap: 1.1rem; }
  @media (min-width: 900px) { .footer__brand-right { align-items: flex-end; text-align: right; } }
  .footer__brand-note { max-width: 34ch; font-size: 0.95rem; color: var(--color-onink-soft); }
  .footer__social { display: flex; gap: 0.6rem; }
  .footer__social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-cream) 28%, transparent);
    color: var(--color-cream); transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .footer__social a:hover { background: var(--color-gold); border-color: var(--color-gold); color: #2a1c07; transform: translateY(-2px); }

  .footer__rule { margin-block: clamp(2rem, 4vw, 3rem); opacity: 0.7; }

  /* Mobil: Kontakt volle Breite, darunter „Seite" und „Rechtliches" nebeneinander. */
  .footer__grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 1.5rem; row-gap: 2rem; }
  .footer__col--wide { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .footer__grid { grid-template-columns: 1.6fr 1fr 1fr; column-gap: 2rem; }
    .footer__col--wide { grid-column: auto; }
  }

  .footer__h {
    font-family: var(--font-sans);
    font-size: 0.74rem; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-gold-soft); margin-bottom: 1rem;
  }
  .footer__addr { font-style: normal; font-size: 0.95rem; line-height: 1.8; }
  .footer__addr a:hover, .footer__links a:hover { color: #fff; text-decoration: underline; }
  .footer__wa { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1rem; font-size: 0.92rem; }
  .footer__wa:hover { color: #fff; }
  .footer__links { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.95rem; }
  .footer__consent { background: none; border: 0; color: inherit; cursor: pointer; padding: 0; font: inherit; text-align: left; }
  .footer__consent:hover { color: #fff; text-decoration: underline; }

  .footer__bottom {
    margin-top: clamp(2rem, 4vw, 3rem); padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 14%, transparent);
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between;
    font-size: 0.85rem; color: color-mix(in srgb, var(--color-cream) 55%, transparent);
  }
</style>
