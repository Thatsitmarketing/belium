---
import { navItems } from '@/data/inhalt';
import { telLink } from '@/data/site';
import Icon from '@/components/Icon.astro';
import Wordmark from '@/components/Wordmark.astro';

interface Props {
  /** true auf Seiten ohne dunklen Hero (z. B. Rechtsseiten): Header startet solide. */
  solid?: boolean;
}
const { solid = false } = Astro.props;
---
<header id="siteheader" class={`siteheader${solid ? ' is-solid' : ''}`} data-header>
  <div class="container-page siteheader__inner">
    <a href="#top" class="siteheader__brand" aria-label="Belium Beauty Startseite">
      <Wordmark size="sm" />
    </a>

    <nav class="nav-desktop" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        <a href={item.href} class="nav-desktop__link">{item.label}</a>
      ))}
    </nav>

    <div class="siteheader__cta">
      <a href={telLink()} class="nav-phone" data-track="telefon_klick" aria-label="Anrufen">
        <Icon name="phone" class="w-5 h-5" />
      </a>
      <a href="#kontakt" class="btn btn-primary btn--sm">Termin anfragen</a>
    </div>

    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label="Menü öffnen"
    >
      <Icon name="menu" class="w-6 h-6 nav-toggle__open" />
      <Icon name="close" class="w-6 h-6 nav-toggle__close" />
    </button>
  </div>

  <div class="nav-mobile" id="nav-mobile" hidden>
    <nav aria-label="Mobile Navigation" class="container-page nav-mobile__list">
      {navItems.map((item) => (
        <a href={item.href} class="nav-mobile__link" data-nav-close>
          <span>{item.label}</span>
          <Icon name="arrow-up-right" class="w-4 h-4 nav-mobile__link-icon" />
        </a>
      ))}
      <a href="#kontakt" class="btn btn-primary nav-mobile__cta" data-nav-close>Termin anfragen</a>
    </nav>
  </div>
</header>

<style>
  .siteheader {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 80;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease, color 0.35s ease;
    /* Standard (ueber dem hellen Hero): dunkle Schrift */
    color: var(--color-ink);
  }
  /* Nach dem Scrollen: heller, glasiger Balken mit dunkler Schrift */
  .siteheader.is-scrolled,
  .siteheader.is-solid {
    background: color-mix(in srgb, var(--color-cream) 90%, transparent);
    backdrop-filter: saturate(150%) blur(12px);
    border-bottom-color: color-mix(in srgb, var(--color-sand-deep) 60%, transparent);
    color: var(--color-ink);
  }
  /* Bei offenem Mobile-Menue ebenfalls solide */
  .siteheader.is-open {
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .siteheader__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: 1rem;
  }
  .siteheader__brand { text-decoration: none; color: inherit; }

  .nav-desktop { display: none; gap: 1.35rem; }
  .nav-desktop__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: inherit;
    opacity: 0.9;
    text-decoration: none;
    position: relative;
    padding: 0.25rem 0;
    transition: opacity 0.2s ease;
  }
  .nav-desktop__link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -3px;
    width: 0; height: 2px;
    border-radius: 2px;
    background: var(--gradient-gold);
    transition: width 0.28s cubic-bezier(0.22,1,0.36,1);
  }
  .nav-desktop__link:hover { opacity: 1; }
  .nav-desktop__link:hover::after { width: 100%; }

  .siteheader__cta { display: none; align-items: center; gap: 0.85rem; }
  .nav-phone {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    color: inherit; border: 1.5px solid color-mix(in srgb, currentColor 32%, transparent);
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .nav-phone:hover { border-color: var(--color-gold); color: var(--color-gold); }

  .nav-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem; color: inherit; background: transparent; border: 0;
  }
  .nav-toggle :global(.nav-toggle__close) { display: none; }
  .nav-toggle[aria-expanded='true'] :global(.nav-toggle__open) { display: none; }
  .nav-toggle[aria-expanded='true'] :global(.nav-toggle__close) { display: block; }

  .nav-mobile {
    border-top: 1px solid color-mix(in srgb, var(--color-sand-deep) 60%, transparent);
    background: var(--color-cream);
    color: var(--color-ink);
    box-shadow: var(--shadow-card);
  }
  .nav-mobile__list { display: flex; flex-direction: column; padding-block: 0.75rem 1.5rem; gap: 0.15rem; }
  .nav-mobile__link {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 1.1rem; font-weight: 600; color: var(--color-ink);
    text-decoration: none; padding: 0.9rem 0.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-sand) 80%, transparent);
  }
  .nav-mobile__link :global(.nav-mobile__link-icon) { color: var(--color-gold-deep); opacity: 0.7; }
  .nav-mobile__cta { margin-top: 1.1rem; }

  @media (min-width: 1024px) {
    .nav-desktop { display: flex; }
    .siteheader__cta { display: flex; }
    .nav-toggle { display: none; }
    .nav-mobile { display: none; }
  }
</style>

<script>
  const header = document.getElementById('siteheader');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');

  function setMenu(open: boolean) {
    if (!toggle || !menu || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    menu.hidden = !open;
    header.classList.toggle('is-open', open);
  }

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });
  menu?.querySelectorAll('[data-nav-close]').forEach((el) =>
    el.addEventListener('click', () => setMenu(false))
  );

  // Solider Balken sobald der Hero verlassen wird
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
