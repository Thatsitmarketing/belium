  sparkle: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/><path d="M5 16l.7 1.8L7.5 18.5 5.7 19.2 5 21l-.7-1.8L2.5 18.5l1.8-.7L5 16z"/>',
  // Feineres, edleres Funkel-Icon (Premium)
  spark: '<path d="M12 2.5c.3 3.9 1.6 6.6 3.6 8.1 1.4 1 3 1.4 4.9 1.4-3.9.3-6.6 1.6-8.1 3.6-1 1.4-1.4 3-1.4 4.9-.3-3.9-1.6-6.6-3.6-8.1-1.4-1-3-1.4-4.9-1.4 3.9-.3 6.6-1.6 8.1-3.6 1-1.4 1.4-3 1.4-4.9z"/>',
  gem: '<path d="M6 4h12l3 5-9 11L3 9l3-5z"/><path d="M3 9h18M9 4l-3 5 6 11M15 4l3 5-6 11M9 4l3 5 3-5M6 9l6 0 6 0"/>',
  // Laser / Diode
  laser: '<circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/>',
  droplet: '<path d="M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z"/><path d="M9.5 14a2.5 2.5 0 002.5 2.5"/>',
  hand: '<path d="M8 11V6.5a1.5 1.5 0 013 0V11m0-1V5a1.5 1.5 0 013 0v6m0-2.5a1.5 1.5 0 013 0V15a6 6 0 01-6 6h-1.2a5 5 0 01-3.6-1.5L5 16.5a1.6 1.6 0 012.4-2.1L8.5 15"/>',
  award: '<circle cx="12" cy="9" r="5"/><path d="M9 13.5L7.5 21l4.5-2.5L16.5 21 15 13.5"/><path d="M12 7v2l1.4.8"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
