---
/**
 * Schlanke Inline-SVG-Icons (kein Icon-Font, kein externes Paket).
 * Verwendung: <Icon name="phone" class="w-5 h-5" />
 * Alle Icons erben die Textfarbe (stroke/fill: currentColor).
 */
interface Props {
  name: string;
  class?: string;
  title?: string;
}
const { name, class: className = 'w-6 h-6', title } = Astro.props;

const paths: Record<string, string> = {
  shield: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  snowflake: '<path d="M12 3v18M5 7l14 10M19 7L5 17"/><path d="M12 3l-2 2m2-2l2 2M5 7l.3 2.7M5 7l2.7-.3M19 17l-.3-2.7M19 17l-2.7.3M19 7l-2.7-.3M19 7l-.3 2.7M5 17l2.7.3M5 17l.3-2.7M12 21l-2-2m2 2l2-2"/>',
  feather: '<path d="M20 4C11 4 6 10 6 16v2H4"/><path d="M6 18l9-9M13 4h3v3M11 6h3v3M9 8h3v3"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.6" fill="currentColor" stroke="none"/>',
  leaf: '<path d="M4 20C4 11 10 5 20 5c0 10-6 15-14 15a6 6 0 01-2-.3z"/><path d="M4 20c3-6 7-9 12-11"/>',
  sparkle: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/><path d="M5 16l.7 1.8L7.5 18.5 5.7 19.2 5 21l-.7-1.8L2.5 18.5l1.8-.7L5 16z"/>',
  phone: '<path d="M4 5c0-1 1-2 2-2h2l2 5-2.5 1.5a12 12 0 006 6L17 14l5 2v2c0 1-1 2-2 2A16 16 0 014 5z"/>',
  whatsapp: '<path d="M12 3a9 9 0 00-7.7 13.6L3 21l4.5-1.2A9 9 0 1012 3z"/><path d="M8.5 8.5c-.3.6-.4 1.4 0 2.3a8 8 0 004.7 4.7c.9.4 1.7.3 2.3 0l.8-1.3-2-1-1 .8a6 6 0 01-3-3l.8-1-1-2-1.4.8z" fill="currentColor" stroke="none"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  star: '<path d="M12 3l2.6 5.6L21 9.4l-4.5 4.3L17.7 21 12 17.6 6.3 21l1.2-7.3L3 9.4l6.4-.8L12 3z" fill="currentColor" stroke="none"/>',
  map: '<path d="M9 3L4 5v16l5-2 6 2 5-2V3l-5 2-6-2z"/><path d="M9 3v16M15 5v16"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  check: '<path d="M5 12l4.5 4.5L19 7"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="M8.5 12l2.5 2.5L16 9"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/>',
  car: '<path d="M5 16v2a1 1 0 001 1h1a1 1 0 001-1v-1h8v1a1 1 0 001 1h1a1 1 0 001-1v-2M5 16l1.5-5A2 2 0 018.4 9.6h7.2A2 2 0 0117.5 11L19 16M5 16h14"/><circle cx="8" cy="16" r="0.01"/><circle cx="16" cy="16" r="0.01"/>',
  parking: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 16V8h3a2.5 2.5 0 010 5H9"/>',
  facebook: '<path d="M14 8h2V5h-2a3 3 0 00-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14v-2c0-.5.4-1 1-1z" fill="currentColor" stroke="none"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.5"/><circle cx="16.5" cy="7.5" r="0.8" fill="currentColor" stroke="none"/>',
};

const inner = paths[name] ?? '';
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  set:html={(title ? `<title>${title}</title>` : '') + inner}
/>
