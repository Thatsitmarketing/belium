  route: '<circle cx="6" cy="18" r="2.4"/><circle cx="18" cy="6" r="2.4"/><path d="M8.4 18H14a3.5 3.5 0 000-7H10a3.5 3.5 0 010-7h5.6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/>',
  heart: '<path d="M12 20s-7-4.4-9.3-8.2C1.2 9.1 2.4 5.8 5.5 5.2 7.6 4.8 9.4 6 12 8.4 14.6 6 16.4 4.8 18.5 5.2c3.1.6 4.3 3.9 2.8 6.6C19 15.6 12 20 12 20z"/>',
  quote: '<path d="M9 7H5.5A1.5 1.5 0 004 8.5V12a3 3 0 003 3H9zM20 7h-3.5A1.5 1.5 0 0015 8.5V12a3 3 0 003 3h2z"/>',
  cookie: '<path d="M12 3a9 9 0 108.94 8 3 3 0 01-3.44-3.5A3 3 0 0114 4.06 9 9 0 0012 3z"/><circle cx="9" cy="10" r="1" fill="currentColor" stroke="none"/><circle cx="14.5" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="9.5" cy="15" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="9.5" r="0.9" fill="currentColor" stroke="none"/>',
  euro: '<path d="M17 6.5A6.5 6.5 0 006 11m0 2a6.5 6.5 0 0011 4.5M4 10h8M4 14h7"/>',
  chat: '<path d="M4 5h16a1 1 0 011 1v9a1 1 0 01-1 1H9l-4 3v-3H4a1 1 0 01-1-1V6a1 1 0 011-1z"/><path d="M8 9.5h8M8 12.5h5"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6"/>',
  // --- Navigation / UI ---
  phone: '<path d="M4 5c0-1 1-2 2-2h2l2 5-2.5 1.5a12 12 0 006 6L17 14l5 2v2c0 1-1 2-2 2A16 16 0 014 5z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-down': '<path d="M12 5v14M6 13l6 6 6-6"/>',
  'arrow-up-right': '<path d="M7 17L17 7M8 7h9v9"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  star: '<path d="M12 3l2.6 5.6L21 9.4l-4.5 4.3L17.7 21 12 17.6 6.3 21l1.2-7.3L3 9.4l6.4-.8L12 3z" fill="currentColor" stroke="none"/>',
  map: '<path d="M9 3L4 5v16l5-2 6 2 5-2V3l-5 2-6-2z"/><path d="M9 3v16M15 5v16"/>',
  'map-pin': '<path d="M12 21s7-5.7 7-11a7 7 0 10-14 0c0 5.3 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  check: '<path d="M5 12l4.5 4.5L19 7"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="M8.5 12l2.5 2.5L16 9"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/>',
  car: '<path d="M5 16v2a1 1 0 001 1h1a1 1 0 001-1v-1h8v1a1 1 0 001 1h1a1 1 0 001-1v-2M5 16l1.5-5A2 2 0 018.4 9.6h7.2A2 2 0 0117.5 11L19 16M5 16h14"/><circle cx="8" cy="16" r="0.01"/><circle cx="16" cy="16" r="0.01"/>',
  parking: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 16V8h3a2.5 2.5 0 010 5H9"/>',
  facebook: '<path d="M14 8h2V5h-2a3 3 0 00-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14v-2c0-.5.4-1 1-1z" fill="currentColor" stroke="none"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.5"/><circle cx="16.5" cy="7.5" r="0.8" fill="currentColor" stroke="none"/>',
};

const inner = paths[name] ?? '';
// Eindeutige, aber stabile Gradient-ID pro Icon-Name (identische Definitionen kollidieren nicht).
const gradId = `ig-${name}`;
const defs = gradient
  ? `<defs><linearGradient id="${gradId}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f7d488"/><stop offset="0.4" stop-color="#e6b25a"/><stop offset="0.72" stop-color="#b47f2c"/><stop offset="1" stop-color="#6e3b0e"/></linearGradient></defs>`
  : '';
const strokeVal = gradient ? `url(#${gradId})` : 'currentColor';
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke={strokeVal}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  set:html={defs + (title ? `<title>${title}</title>` : '') + inner}
/>
