---
/**
 * Schlanke Inline-SVG-Icons (kein Icon-Font, kein externes Paket).
 * Verwendung: <Icon name="phone" class="w-5 h-5" />
 * Optional: <Icon name="spark" gradient /> rendert die Linien im Logo-Goldverlauf.
 * Ohne gradient erben die Icons die Textfarbe (currentColor).
 */
interface Props {
  name: string;
  class?: string;
  title?: string;
  gradient?: boolean;
}
const { name, class: className = 'w-6 h-6', title, gradient = false } = Astro.props;

const paths: Record<string, string> = {
  // --- Vertrauen / Behandlung ---
  shield: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  snowflake: '<path d="M12 3v18M5 7l14 10M19 7L5 17"/><path d="M12 3l-2 2m2-2l2 2M5 7l.3 2.7M5 7l2.7-.3M19 17l-.3-2.7M19 17l-2.7.3M19 7l-2.7-.3M19 7l-.3 2.7M5 17l2.7.3M5 17l.3-2.7M12 21l-2-2m2 2l2-2"/>',
  feather: '<path d="M20 4C11 4 6 10 6 16v2H4"/><path d="M6 18l9-9M13 4h3v3M11 6h3v3M9 8h3v3"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.6" fill="currentColor" stroke="none"/>',
