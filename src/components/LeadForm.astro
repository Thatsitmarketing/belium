---
import { site } from '@/data/site';
import Icon from '@/components/Icon.astro';
import { wunschzonen } from '@/data/inhalt';

/**
 * Wiederverwendbares Lead-/Kontaktformular.
 * Versendet an die Cloudflare Pages Function /api/lead.
 * Spam-Schutz: Honeypot-Feld ("website") + optional Cloudflare Turnstile (kein reCAPTCHA).
 *
 * Preise werden bewusst nicht auf der Seite gezeigt – die Anfrage geht immer
 * über die kostenlose Beratung.
 */
interface Props {
  id: string;
  eventName?: string;
}
const { id, eventName = 'formular_absenden' } = Astro.props;
const hasTurnstile = Boolean(site.turnstileSiteKey);
---
<form
  class="leadform"
  id={id}
  data-event={eventName}
  novalidate
>
  <!-- Honeypot: fuer Menschen unsichtbar, Bots fuellen es aus -->
  <div class="hp" aria-hidden="true">
    <label>Bitte dieses Feld frei lassen
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <input type="hidden" name="quelle" value="kontakt" />

  <div class="leadform__row">
    <div class="field">
      <label for={`${id}-name`}>Name<span class="req" aria-hidden="true">*</span></label>
      <input id={`${id}-name`} name="name" type="text" required autocomplete="name" placeholder="Vor- und Nachname" />
    </div>
  </div>

  <div class="leadform__row leadform__row--2">
    <div class="field">
      <label for={`${id}-email`}>E-Mail</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="name@beispiel.de" />
    </div>
    <div class="field">
      <label for={`${id}-telefon`}>Telefon</label>
      <input id={`${id}-telefon`} name="telefon" type="tel" autocomplete="tel" placeholder="Für einen Rückruf" />
    </div>
  </div>
  <p class="field__hint">Gib mindestens E-Mail oder Telefon an, damit wir dich erreichen können.</p>

  <div class="leadform__row">
    <div class="field">
      <label for={`${id}-zone`}>Wunschzone</label>
      <div class="select">
        <select id={`${id}-zone`} name="wunschzone">
          <option value="">Bitte wählen</option>
          {wunschzonen.map((z) => (
            <option value={z.name}>{z.name}{z.hinweis ? ` (${z.hinweis})` : ''}</option>
          ))}
          <option value="Mehrere Zonen">Mehrere Zonen</option>
          <option value="Noch unklar – bitte beraten">Noch unklar – bitte beraten</option>
        </select>
        <Icon name="chevron" class="w-4 h-4 select__ic" />
      </div>
    </div>
  </div>

  <div class="leadform__row">
    <div class="field">
      <label for={`${id}-nachricht`}>Nachricht</label>
      <textarea id={`${id}-nachricht`} name="nachricht" rows={4} placeholder="Worum geht es? Fragen? Wunschtermin?"></textarea>
    </div>
  </div>

  <div class="field field--check">
    <label class="checkbox">
      <input type="checkbox" name="datenschutz" required />
      <span>Ich habe die <a href="/datenschutz" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Kontaktaufnahme einverstanden.<span class="req" aria-hidden="true">*</span></span>
    </label>
  </div>

  {hasTurnstile && (
    <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-theme="light"></div>
  )}

  <button type="submit" class="btn btn-primary leadform__submit">
    <Icon name="arrow" class="w-4 h-4" />
    Kostenlose Beratung anfragen
  </button>

  <p class="leadform__status" role="status" aria-live="polite" data-status hidden></p>
</form>

<!-- Danke-Fenster: ersetzt nach erfolgreichem Versand das Formular -->
<div class="leadsuccess" data-success-for={id} role="status" aria-live="polite" hidden>
  <span class="leadsuccess__ic" aria-hidden="true">
    <svg viewBox="0 0 52 52" class="leadsuccess__svg" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <circle class="leadsuccess__circle" cx="26" cy="26" r="23" stroke-width="2.5" />
      <path class="leadsuccess__check" d="M15.5 26.8l7.2 7.2 13.8-15" stroke-width="3.4" />
    </svg>
  </span>
  <h3 class="leadsuccess__title">Danke für deine Anfrage!</h3>
  <p class="leadsuccess__text">
    Deine Nachricht ist bei uns angekommen. Maria meldet sich zeitnah persönlich bei dir,
    um deine kostenlose Beratung zu terminieren.
  </p>
  <button type="button" class="leadsuccess__again" data-success-reset>Weitere Anfrage senden</button>
</div>

<style>
  .leadform { display: flex; flex-direction: column; gap: 0.9rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .leadform__row--2 { display: grid; grid-template-columns: 1fr; gap: 0.9rem; }
  @media (min-width: 560px) { .leadform__row--2 { grid-template-columns: 1fr 1fr; } }

  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field label { font-size: 0.9rem; font-weight: 700; color: var(--color-ink); }
  .req { color: var(--color-rose); margin-left: 0.15rem; }
  .field input, .field textarea {
    width: 100%;
    background: #fff;
    border: 1.5px solid var(--color-sand-deep);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: 0.98rem;
    color: var(--color-ink);
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .field input::placeholder, .field textarea::placeholder { color: color-mix(in srgb, var(--color-mocha) 75%, transparent); }
  .field input:focus, .field textarea:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-gold) 25%, transparent);
  }
  .field textarea { resize: vertical; min-height: 3rem; }

  /* Auswahlfeld (Wunschzone) im Look der übrigen Felder */
  .select { position: relative; display: block; }
  .select select {
    appearance: none; width: 100%;
    background: #fff;
    border: 1.5px solid var(--color-sand-deep);
    border-radius: var(--radius-sm);
    padding: 0.75rem 2.6rem 0.75rem 0.9rem;
    font: inherit; font-size: 0.98rem; color: var(--color-ink); cursor: pointer;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .select select:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-gold) 25%, transparent);
  }
  .select :global(.select__ic) {
    position: absolute; right: 0.9rem; top: 50%; transform: translateY(-50%);
    color: var(--color-mocha); pointer-events: none;
  }
  .field__hint { font-size: 0.82rem; color: var(--color-mocha); margin-top: -0.3rem; }

  .field--check { margin-top: 0.2rem; }
  .checkbox { display: flex; align-items: flex-start; gap: 0.6rem; font-weight: 500; font-size: 0.88rem; color: var(--color-ink-soft); cursor: pointer; }
  .checkbox input { margin-top: 0.15rem; width: 1.1rem; height: 1.1rem; flex: 0 0 auto; accent-color: var(--color-gold); }
  .checkbox a { color: var(--color-gold-deep); text-decoration: underline; }

  .leadform__submit { margin-top: 0.4rem; align-self: flex-start; }
  .leadform__status { font-size: 0.92rem; font-weight: 600; padding: 0.6rem 0; }
  .leadform__status.is-ok { color: #2f7a43; }
  .leadform__status.is-error { color: #b23b3b; }
  .leadform.is-sending .leadform__submit { opacity: 0.65; pointer-events: none; }
  .leadform[hidden] { display: none; }

  /* --- Danke-Fenster --- */
  .leadsuccess {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: clamp(1.5rem, 4vw, 2.5rem) 0.5rem;
    animation: ls-in 0.45s cubic-bezier(0.22,1,0.36,1);
  }
  .leadsuccess[hidden] { display: none; }
  @keyframes ls-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .leadsuccess__ic {
    display: inline-flex; align-items: center; justify-content: center;
    width: 5.25rem; height: 5.25rem; border-radius: 50%; margin-bottom: 1.1rem;
    background: color-mix(in srgb, var(--color-gold-soft) 40%, #fff);
    border: 1px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    box-shadow: var(--shadow-gold);
  }
  .leadsuccess__svg { width: 3.1rem; height: 3.1rem; stroke: var(--color-gold-deep); }
  .leadsuccess__circle { stroke-dasharray: 145; stroke-dashoffset: 145; animation: ls-circle 0.6s cubic-bezier(0.65,0,0.45,1) forwards; }
  .leadsuccess__check { stroke-dasharray: 40; stroke-dashoffset: 40; animation: ls-check 0.35s cubic-bezier(0.65,0,0.45,1) 0.5s forwards; }
  @keyframes ls-circle { to { stroke-dashoffset: 0; } }
  @keyframes ls-check { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .leadsuccess { animation: none; }
    .leadsuccess__circle, .leadsuccess__check { animation: none; stroke-dashoffset: 0; }
  }

  .leadsuccess__title { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.5rem, 3.5vw, 1.9rem); color: var(--color-ink); }
  .leadsuccess__text { margin-top: 0.6rem; color: var(--color-ink-soft); font-size: 0.98rem; line-height: 1.6; max-width: 34ch; }
  .leadsuccess__again {
    margin-top: 1.3rem; background: none; border: 0; cursor: pointer; font: inherit;
    font-size: 0.9rem; font-weight: 700; color: var(--color-gold-deep); text-decoration: underline;
  }
  .leadsuccess__again:hover { color: var(--color-ink); }
</style>

<script>
  // Client-Logik fuer alle LeadForm-Instanzen
  document.querySelectorAll<HTMLFormElement>('form.leadform').forEach((form) => {
    const statusEl = form.querySelector<HTMLElement>('[data-status]');
    const successEl = document.querySelector<HTMLElement>(`[data-success-for="${form.id}"]`);
    const resetBtn = successEl?.querySelector<HTMLButtonElement>('[data-success-reset]');

    // Nach Erfolg das Formular ausblenden und das Danke-Fenster zeigen.
    const showSuccess = () => {
      if (!successEl) {
        setStatus('Danke! Deine Anfrage ist bei uns. Wir melden uns zeitnah.', 'ok');
        return;
      }
      form.hidden = true;
      successEl.hidden = false;
      // Umgebende Karte kann darauf reagieren (z. B. eigene Überschrift ausblenden).
      form.parentElement?.classList.add('has-lead-success');
      successEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };

    resetBtn?.addEventListener('click', () => {
      if (successEl) successEl.hidden = true;
      form.hidden = false;
      form.parentElement?.classList.remove('has-lead-success');
      form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    });
    const setStatus = (msg: string, kind: 'ok' | 'error' | '') => {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.hidden = !msg;
      statusEl.classList.remove('is-ok', 'is-error');
      if (kind === 'ok') statusEl.classList.add('is-ok');
      if (kind === 'error') statusEl.classList.add('is-error');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);

      // Honeypot
      if ((data.get('website') as string)?.length) return;

      const name = (data.get('name') as string)?.trim();
      const email = (data.get('email') as string)?.trim();
      const telefon = (data.get('telefon') as string)?.trim();
      const datenschutz = data.get('datenschutz');

      if (!name) return setStatus('Bitte gib deinen Namen an.', 'error');
      if (!email && !telefon) return setStatus('Bitte gib E-Mail oder Telefon an.', 'error');
      if (!datenschutz) return setStatus('Bitte stimme der Datenschutzerklärung zu.', 'error');

      form.classList.add('is-sending');
      setStatus('Wird gesendet …', '');
      (window as any).trackEvent?.(form.dataset.event || 'formular_absenden', {
        quelle: data.get('quelle'),
      });

      try {
        const res = await fetch('/api/lead', { method: 'POST', body: data });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          form.reset();
          setStatus('', '');
          showSuccess();
        } else {
          setStatus(json.error || 'Es gab ein Problem. Bitte ruf uns kurz an, wir helfen sofort.', 'error');
        }
      } catch (err) {
        setStatus('Verbindung fehlgeschlagen. Bitte ruf uns kurz an, wir helfen sofort.', 'error');
      } finally {
        form.classList.remove('is-sending');
      }
    });
  });
</script>
