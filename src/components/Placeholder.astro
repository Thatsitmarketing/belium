---
/**
 * Elegantes Bild-Platzhalter-Element – für Motive, die noch nicht final vorliegen.
 * Auf Wunsch später einfach durch <Image .../> ersetzen.
 * Props:
 *  - ratio: "portrait" | "landscape" | "square" | "wide"
 *  - label: kurzer Titel (z. B. Zone)
 *  - note:  optionaler Untertitel (z. B. "Bild folgt")
 *  - icon:  Icon-Name (Standard: "spark")
 *  - tone:  "light" | "dark" (Standard: light)
 */
import Icon from '@/components/Icon.astro';
interface Props {
  ratio?: 'portrait' | 'landscape' | 'square' | 'wide';
  label?: string;
  note?: string;
  icon?: string;
  tone?: 'light' | 'dark';
  class?: string;
}
const {
  ratio = 'landscape',
  label,
  note = 'Bild folgt',
  icon = 'spark',
  tone = 'light',
  class: className = '',
} = Astro.props;
const ratios: Record<string, string> = {
  portrait: '3 / 4',
  landscape: '4 / 3',
  square: '1 / 1',
  wide: '16 / 10',
};
---
<div
  class:list={['ph', `ph--${tone}`, className]}
  style={`--ph-ratio:${ratios[ratio]}`}
  role="img"
  aria-label={label ? `Platzhalterbild: ${label}` : 'Platzhalterbild'}
>
  <span class="ph__shine" aria-hidden="true"></span>
  <span class="ph__frame" aria-hidden="true"></span>
  <span class="ph__body">
    <span class="ph__ic"><Icon name={icon} class="w-6 h-6" gradient /></span>
    {label && <span class="ph__label">{label}</span>}
    {note && <span class="ph__note">{note}</span>}
  </span>
</div>

<style>
  .ph {
    position: relative;
    aspect-ratio: var(--ph-ratio, 4 / 3);
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .ph--light {
    background:
      radial-gradient(120% 100% at 20% 0%, color-mix(in srgb, var(--color-gold-soft) 45%, #fff) 0%, transparent 60%),
      linear-gradient(160deg, #fff, var(--color-cream-deep));
    border: 1px solid var(--color-sand);
    color: var(--color-espresso);
  }
  .ph--dark {
    background:
      radial-gradient(120% 100% at 80% 0%, color-mix(in srgb, var(--color-gold) 22%, transparent) 0%, transparent 60%),
      var(--gradient-ink);
    border: 1px solid color-mix(in srgb, var(--color-gold) 24%, transparent);
    color: var(--color-onink-soft);
  }

  /* dezentes Rahmen-Inlay */
  .ph__frame {
    position: absolute; inset: 0.7rem; border-radius: calc(var(--radius-md) - 0.4rem);
    border: 1px dashed color-mix(in srgb, currentColor 28%, transparent);
    pointer-events: none;
  }

  .ph__body {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    text-align: center; padding: 1rem;
  }
  .ph__ic {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3.1rem; height: 3.1rem; border-radius: 50%;
    background: color-mix(in srgb, var(--color-gold) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-gold) 34%, transparent);
  }
  .ph__label { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: inherit; }
  .ph--dark .ph__label { color: #fff; }
  .ph__note {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-gold-deep);
  }
  .ph--dark .ph__note { color: var(--color-gold-light); }

  /* laufender Gold-Schimmer */
  .ph__shine {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 35%, color-mix(in srgb, var(--color-gold-light) 30%, transparent) 50%, transparent 65%);
    background-size: 220% 100%;
    animation: ph-shine 3.6s ease-in-out infinite;
    opacity: 0.5;
  }
  @keyframes ph-shine { 0% { background-position: 140% 0; } 100% { background-position: -40% 0; } }
  @media (prefers-reduced-motion: reduce) { .ph__shine { animation: none; opacity: 0.25; } }
</style>
