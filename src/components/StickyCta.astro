---
import Icon from '@/components/Icon.astro';
/**
 * Dezenter Sticky-CTA auf Mobil: genau ein primärer Button zum Kontaktbereich.
 * Bewusst KEINE zusätzliche Leiste mit mehreren Kontaktoptionen (kein CTA-Stapel).
 * Auf Desktop ausgeblendet – dort sitzt der CTA in der Navigation.
 */
---
<div class="sticky-cta" aria-label="Schnellkontakt">
  <a href="#kontakt" class="btn btn-primary sticky-cta__btn" data-track="cta_sticky">
    <Icon name="arrow" class="w-4 h-4" /> Kostenlose Beratung
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 70;
    display: flex;
    padding: 0.6rem 0.8rem calc(0.6rem + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-cream) 92%, transparent);
    backdrop-filter: blur(8px);
    border-top: 1px solid color-mix(in srgb, var(--color-sand-deep) 70%, transparent);
  }
  .sticky-cta__btn { flex: 1 1 0; min-height: 3rem; font-size: 0.98rem; }
  @media (min-width: 1024px) {
    .sticky-cta { display: none; }
  }
</style>
