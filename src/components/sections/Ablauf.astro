---
/**
 * „So funktioniert die Behandlung" – rein der Ablauf in vier Schritten, visuell mit
 * eigens erstellten Premium-Icons (Gold-Linienstil). Die früheren Technik-Prinzipien
 * wurden bewusst herausgelöst, damit der Fokus klar auf dem Weg (1 → 4) liegt.
 * Die Schritte laufen beim Scrollen gestaffelt ein (Step-Animation).
 */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { ablaufSchritte } from '@/data/ablauf';
import iconBeratung from '@/assets/images/ablauf-icon-beratung-belium.png';
import iconBehandlung from '@/assets/images/ablauf-icon-behandlung-belium.png';
import iconNachsorge from '@/assets/images/ablauf-icon-nachsorge-belium.png';
import iconIntervall from '@/assets/images/ablauf-icon-intervall-belium.png';

const meta = [
  { icon: iconBeratung, alt: 'Sprechblase mit Herz – kostenloses Beratungsgespräch', tag: 'Kostenlos & unverbindlich' },
  { icon: iconBehandlung, alt: 'Diodenlaser-Handstück – die eigentliche Behandlung', tag: 'Wenige Minuten bis ca. 1 Std.' },
  { icon: iconNachsorge, alt: 'Wassertropfen mit Glanz – sanfte Nachsorge der Haut', tag: 'Meist sofort alltagstauglich' },
  { icon: iconIntervall, alt: 'Kalender mit Wiederhol-Pfeilen – Termine im Intervall', tag: 'In der Regel 4–8 Termine' },
];
---
<section id="ablauf" class="section-pad ablauf">
  <div class="container-page">
    <header class="section-head reveal">
      <p class="t-eyebrow">So funktioniert es</p>
      <h2 class="t-h2">Dein Weg in <span class="text-gold">vier Schritten</span></h2>
      <p class="t-lead section-head__lead">
        Kein Druck, kein Verkaufsgespräch – immer mit kostenloser Beratung und Testfleck zum Start.
        So läuft deine dauerhafte Laser Haarentfernung Schritt für Schritt ab.
      </p>
    </header>

    <!-- Ablauf: nummerierte Prozesslinie mit Premium-Icons, Step-Animation 1 → 4 -->
    <ol class="steps" data-steps>
      {ablaufSchritte.map((s, i) => (
        <li class="step" data-step>
          <span class="step__icon">
            <Image src={meta[i].icon} alt={meta[i].alt} widths={[120, 200, 280]} sizes="120px" format="avif" quality={82} class="step__icon-img" />
          </span>
          <h3 class="step__title">{s.titel}</h3>
          <p class="step__text">{s.text}</p>
          <p class="step__tag"><Icon name="clock" class="w-3.5 h-3.5" /> {meta[i].tag}</p>
        </li>
      ))}
    </ol>

    <div class="section-cta section-cta--center reveal">
      <a href="#kontakt" class="btn btn-primary" data-track="cta_ablauf">Ersten Schritt gehen – Beratung anfragen</a>
    </div>
  </div>

  <noscript><style>.ablauf .step{opacity:1 !important;transform:none !important;} .ablauf .step::before{transform:scaleX(1) !important;}</style></noscript>
</section>

<style>
  .ablauf { background: var(--color-cream); }

  /* Prozesslinie – große Premium-Icons, ohne Ziffern, mit mehr Abstand */
  .steps { list-style: none; display: grid; grid-template-columns: 1fr; gap: clamp(2.75rem, 6vw, 4.5rem); }
  @media (min-width: 860px) { .steps { grid-template-columns: repeat(4, 1fr); gap: clamp(2.5rem, 4vw, 4rem); } }

  /* Step-Animation: die Schritte laufen nacheinander (1 → 4) ein –
     Inhalt blendet auf & steigt, die Gold-Linie „zeichnet" sich von links. */
  .step {
    position: relative; padding-top: 1.6rem;
    opacity: 0; transform: translateY(26px);
    transition: opacity 0.65s cubic-bezier(0.22,1,0.36,1), transform 0.65s cubic-bezier(0.22,1,0.36,1);
  }
  .step::before {
    content: ""; position: absolute; top: 0; left: 0; height: 2px; width: 100%;
    background: color-mix(in srgb, var(--color-gold) 55%, transparent);
    transform-origin: left; transform: scaleX(0);
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }
  .step.is-in { opacity: 1; transform: none; }
  .step.is-in::before { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .step { opacity: 1; transform: none; transition: none; }
    .step::before { transform: scaleX(1); transition: none; }
  }

  .step__icon { display: inline-flex; }
  .step__icon-img {
    width: 5.4rem; height: 5.4rem; object-fit: contain;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1) 0.08s, opacity 0.5s ease 0.05s;
  }
  /* Icon „pops" beim Einlaufen zusätzlich sanft hoch */
  .step .step__icon-img { transform: translateY(10px) scale(0.94); opacity: 0; }
  .step.is-in .step__icon-img { transform: none; opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .step .step__icon-img { transform: none; opacity: 1; } }
  .step__title { font-size: 1.35rem; margin-top: 1.1rem; }
  .step__text { margin-top: 0.45rem; color: var(--color-ink-soft); font-size: 0.97rem; }
  .step__tag {
    display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.8rem;
    font-size: 0.78rem; font-weight: 700; color: var(--color-espresso);
  }
  .step__tag :global(svg) { color: var(--color-gold-deep); flex: 0 0 auto; }
</style>

<script>
  // Step-Animation: die vier Schritte laufen beim Eintritt in den Viewport gestaffelt
  // ein (1 → 4) und animieren beim Verlassen wieder aus – so „lebt" der Abschnitt bei
  // jedem Vorbeiscrollen neu. Rein über IntersectionObserver + CSS-Transitions, damit
  // das Scrollen selbst nie blockiert/verzögert wird. Respektiert reduced motion.
  const list = document.querySelector<HTMLElement>('[data-steps]');
  if (list) {
    const steps = Array.from(list.querySelectorAll<HTMLElement>('[data-step]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      steps.forEach((s) => s.classList.add('is-in'));
    } else {
      let timers: number[] = [];
      const clear = () => { timers.forEach((t) => clearTimeout(t)); timers = []; };
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          clear();
          if (e.isIntersecting) {
            steps.forEach((s, i) => { timers.push(window.setTimeout(() => s.classList.add('is-in'), i * 170)); });
          } else {
            steps.forEach((s) => s.classList.remove('is-in'));
          }
        });
      }, { threshold: 0.2 });
      io.observe(list);
    }
  }
</script>
