---
/** Ablauf als vertikale Gold-Timeline mit Icons und Nodes – kreativ statt Karten-Raster. */
import { ablaufSchritte } from '@/data/ablauf';
import Icon from '@/components/Icon.astro';

// Icon + Kurz-Meta je Schritt (aus dem vorhandenen Text abgeleitet, keine erfundenen Fakten).
const meta = [
  { icon: 'chat', tag: 'Kostenlos & unverbindlich' },
  { icon: 'laser', tag: 'Wenige Minuten bis ca. 1 Std.' },
  { icon: 'heart', tag: 'Meist sofort alltagstauglich' },
  { icon: 'route', tag: 'In der Regel 4–8 Termine' },
];
---
<section id="ablauf" class="section-pad ablauf">
  <div class="container-page">
    <header class="section-head reveal">
      <p class="t-eyebrow">So läuft es ab</p>
      <h2 class="t-h2">Dein Weg zur <span class="text-gold">glatten Haut</span></h2>
      <p class="t-lead section-head__lead">
        Kein Druck, kein Verkaufsgespräch. Wir starten immer mit einer kostenlosen Beratung samt
        Testfleck – und begleiten dich Schritt für Schritt.
      </p>
    </header>

    <ol class="timeline">
      <span class="timeline__rail" aria-hidden="true"><span class="timeline__rail-fill" data-rail-fill></span></span>
      {ablaufSchritte.map((s, i) => (
        <li class="timeline__item reveal">
          <div class="timeline__node" aria-hidden="true">
            <span class="timeline__node-ring"></span>
            <Icon name={meta[i].icon} class="w-5 h-5" gradient />
          </div>
          <div class="timeline__card">
            <div class="timeline__top">
              <span class="timeline__num num-gold">{s.nummer}</span>
              <span class="timeline__tag"><Icon name="clock" class="w-3.5 h-3.5" /> {meta[i].tag}</span>
            </div>
            <h3 class="timeline__title">{s.titel}</h3>
            <p class="timeline__text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ablauf { background: var(--color-cream); }

  .timeline { list-style: none; position: relative; margin-top: 0.5rem; padding-left: 3.5rem; }
  @media (min-width: 760px) { .timeline { padding-left: 4.25rem; } }

  /* Gold-Schiene */
  .timeline__rail {
    position: absolute; left: 1.6rem; top: 0.6rem; bottom: 0.6rem; width: 2px;
    background: color-mix(in srgb, var(--color-sand-deep) 75%, transparent);
    border-radius: 2px; overflow: hidden;
  }
  @media (min-width: 760px) { .timeline__rail { left: 1.95rem; } }
  .timeline__rail-fill { position: absolute; inset: 0 0 auto 0; height: 0; background: var(--gradient-gold); transition: height 0.1s linear; }

  .timeline__item { position: relative; padding-bottom: 2rem; }
  .timeline__item:last-child { padding-bottom: 0; }

  .timeline__node {
    position: absolute; left: -3.5rem; top: 0;
    width: 3.2rem; height: 3.2rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background:
      linear-gradient(#fff, #fff) padding-box,
      var(--gradient-gold) border-box;
    border: 2px solid transparent; box-shadow: var(--shadow-soft); z-index: 1;
  }
  @media (min-width: 760px) { .timeline__node { left: -4.25rem; width: 3.9rem; height: 3.9rem; } }
  .timeline__node-ring {
    position: absolute; inset: -6px; border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent); opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .timeline__item:hover .timeline__node-ring { opacity: 1; transform: scale(1.05); }

  .timeline__card {
    background: #fff; border: 1px solid var(--color-sand); border-radius: var(--radius-md);
    padding: 1.4rem 1.5rem; box-shadow: var(--shadow-soft);
    transition: transform 0.25s cubic-bezier(0.22,1,0.36,1), box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .timeline__item:hover .timeline__card { transform: translateY(-3px); box-shadow: var(--shadow-card); border-color: var(--color-gold-soft); }
  .timeline__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }
  .timeline__num { font-size: 1.9rem; line-height: 1; }
  .timeline__tag {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.74rem; font-weight: 700; color: var(--color-espresso);
    background: color-mix(in srgb, var(--color-gold-soft) 34%, #fff);
    border: 1px solid var(--color-sand-deep); border-radius: 999px; padding: 0.28rem 0.7rem;
  }
  .timeline__tag :global(svg) { color: var(--color-gold-deep); }
  .timeline__title { font-size: 1.3rem; }
  .timeline__text { margin-top: 0.5rem; color: var(--color-ink-soft); font-size: 0.97rem; }
</style>

<script>
  // Gold-Schiene fuellt sich passend zum Scroll (dezent, respektiert reduced motion).
  const rail = document.querySelector<HTMLElement>('[data-rail-fill]');
  const tl = document.querySelector<HTMLElement>('.timeline');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (rail && tl && !prefersReduced) {
    const onScroll = () => {
      const r = tl.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = r.height;
      const progress = Math.min(1, Math.max(0, (vh * 0.6 - r.top) / total));
      rail.style.height = (progress * 100).toFixed(1) + '%';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  } else if (rail) {
    rail.style.height = '100%';
  }
</script>
