---
/**
 * „So funktioniert die Behandlung" – neues, offenes Designkonzept ohne Kacheln:
 * oben die drei Technik-Prinzipien als schlichte, mit Haarlinien getrennte Reihe,
 * darunter der Ablauf als durchgehende, nummerierte Prozesslinie (keine Karten).
 */
import { ablaufSchritte } from '@/data/ablauf';
import Icon from '@/components/Icon.astro';

// Icon + Kurz-Meta je Schritt (aus dem vorhandenen Text abgeleitet, keine erfundenen Fakten).
const meta = [
  { icon: 'chat', tag: 'Kostenlos & unverbindlich' },
  { icon: 'laser', tag: 'Wenige Minuten bis ca. 1 Std.' },
  { icon: 'heart', tag: 'Meist sofort alltagstauglich' },
  { icon: 'route', tag: 'In der Regel 4–8 Termine' },
];

const prinzipien = [
  { icon: 'laser', titel: '808 nm Wellenlänge', text: 'Die Energie wird gezielt über das Farbpigment des Haares aufgenommen.' },
  { icon: 'snowflake', titel: 'Saphir-Kontaktkühlung', text: 'Die Haut wird im selben Moment gekühlt – spürbar angenehmer.' },
  { icon: 'target', titel: 'Individuelle Einstellung', text: 'Parameter passend zu Hauttyp, Haarstruktur und Körperzone.' },
];
---
<section id="ablauf" class="section-pad ablauf">
  <div class="container-page">
    <header class="section-head reveal">
      <p class="t-eyebrow">So funktioniert es</p>
      <h2 class="t-h2">So funktioniert die <span class="text-gold">Behandlung</span></h2>
      <p class="t-lead section-head__lead">
        Zuerst kurz die Technik dahinter – dann dein Weg in vier verständlichen Schritten. Kein Druck,
        kein Verkaufsgespräch, immer mit kostenloser Beratung und Testfleck zum Start.
      </p>
    </header>

    <!-- Technik-Prinzipien: offene Reihe, mit Haarlinien getrennt (keine Kacheln) -->
    <div class="prinzipien reveal" data-reveal-stagger>
      {prinzipien.map((p) => (
        <div class="prinzip" data-reveal="up">
          <span class="prinzip__ic"><Icon name={p.icon} class="w-6 h-6" gradient /></span>
          <div>
            <h3 class="prinzip__titel">{p.titel}</h3>
            <p class="prinzip__text">{p.text}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Ablauf: durchgehende, nummerierte Prozesslinie mit Step-Animation (1 → 4) -->
    <ol class="steps" data-steps>
      {ablaufSchritte.map((s, i) => (
        <li class="step" data-step>
          <div class="step__head">
            <span class="step__num num-gold">{s.nummer}</span>
            <span class="step__ic"><Icon name={meta[i].icon} class="w-4 h-4" gradient /></span>
          </div>
          <h3 class="step__title">{s.titel}</h3>
          <p class="step__text">{s.text}</p>
          <p class="step__tag"><Icon name="clock" class="w-3.5 h-3.5" /> {meta[i].tag}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ablauf { background: var(--color-cream); }

  /* Technik-Prinzipien – offen, mit feinen Trennlinien */
  .prinzipien { display: grid; grid-template-columns: 1fr; gap: 1.6rem; margin-bottom: clamp(2.75rem, 6vw, 4.5rem); }
  @media (min-width: 760px) { .prinzipien { grid-template-columns: repeat(3, 1fr); gap: 0; } }
  .prinzip { display: flex; align-items: flex-start; gap: 0.9rem; }
  @media (min-width: 760px) {
    .prinzip { padding-inline: clamp(1.25rem, 2.5vw, 2rem); }
    .prinzip + .prinzip { border-left: 1px solid var(--color-sand-deep); }
    .prinzip:first-child { padding-left: 0; }
  }
  .prinzip__ic {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 2.9rem; height: 2.9rem; border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-gold-soft) 26%, #fff);
    border: 1px solid var(--color-sand-deep);
  }
  .prinzip__titel { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; color: var(--color-ink); }
  .prinzip__text { margin-top: 0.3rem; color: var(--color-ink-soft); font-size: 0.94rem; }

  /* Ablauf – durchgehende Prozesslinie mit großen Gold-Ziffern, ohne Karten */
  .steps { list-style: none; display: grid; grid-template-columns: 1fr; gap: 2.25rem; }
  @media (min-width: 860px) { .steps { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; } }

  /* Step-Animation: die Schritte laufen nacheinander (1 → 4) ein –
     Inhalt blendet auf & steigt, die Gold-Linie „zeichnet" sich von links. */
  .step {
    position: relative; padding-top: 1.6rem;
    opacity: 0; transform: translateY(26px);
    transition: opacity 0.65s cubic-bezier(0.22,1,0.36,1), transform 0.65s cubic-bezier(0.22,1,0.36,1);
  }
  .step::before {
    content: ""; position: absolute; top: 0; left: 0; height: 2px; width: 100%;
    background: color-mix(in srgb, var(--color-gold) 55%, transparent);
    transform-origin: left; transform: scaleX(0);
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }
  .step.is-in { opacity: 1; transform: none; }
  .step.is-in::before { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .step { opacity: 1; transform: none; transition: none; }
    .step::before { transform: scaleX(1); transition: none; }
  }
  .step__head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .step__num { font-family: var(--font-display); font-weight: 700; font-size: 2.7rem; line-height: 1; }
  .step__ic {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 2.3rem; height: 2.3rem; border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-gold-soft) 26%, #fff);
    border: 1px solid var(--color-sand-deep);
  }
  .step__title { font-size: 1.35rem; margin-top: 0.85rem; }
  .step__text { margin-top: 0.45rem; color: var(--color-ink-soft); font-size: 0.97rem; }
  .step__tag {
    display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.8rem;
    font-size: 0.78rem; font-weight: 700; color: var(--color-espresso);
  }
  .step__tag :global(svg) { color: var(--color-gold-deep); flex: 0 0 auto; }
</style>

<script>
  // Step-Animation: sobald die Prozesslinie sichtbar wird, laufen die vier
  // Schritte gestaffelt nacheinander ein (1 → 4). Respektiert reduced motion.
  const list = document.querySelector<HTMLElement>('[data-steps]');
  if (list) {
    const steps = Array.from(list.querySelectorAll<HTMLElement>('[data-step]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealAll = () => steps.forEach((s) => s.classList.add('is-in'));
    if (reduce || !('IntersectionObserver' in window)) {
      revealAll();
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            steps.forEach((s, i) => setTimeout(() => s.classList.add('is-in'), i * 180));
            io.disconnect();
          }
        });
      }, { threshold: 0.3 });
      io.observe(list);
    }
  }
</script>
