---
/** Abschnitt 14: Abschluss-CTA. Letzter klarer Handlungsaufruf. */
import { whatsappLink, telLink, site } from '@/data/site';
import Icon from '@/components/Icon.astro';
---
<section id="abschluss" class="section-pad abschluss">
  <div class="container-page">
    <div class="abschluss__box grain reveal">
      <div class="abschluss__glow" aria-hidden="true"></div>
      <p class="t-eyebrow t-eyebrow--center t-eyebrow--on-dark abschluss__eyebrow">Bereit für glatte Haut?</p>
      <h2 class="abschluss__title">Starte mit einer <span class="text-gold">kostenlosen Beratung.</span></h2>
      <p class="abschluss__lead">
        Unverbindlich, ehrlich und mit Testfleck. Wir schauen gemeinsam, was für dich möglich ist.
      </p>
      <div class="abschluss__actions">
        <a href="#kontakt" class="btn btn-primary abschluss__btn" data-track="cta_abschluss">
          <Icon name="arrow" class="w-4 h-4" /> Termin anfragen
        </a>
        <a href={whatsappLink()} class="btn btn-whatsapp abschluss__btn" target="_blank" rel="noopener" data-track="whatsapp_klick">
          <Icon name="whatsapp" class="w-5 h-5" /> WhatsApp
        </a>
        <a href={telLink()} class="btn btn-ghost btn-ghost--on-dark abschluss__btn" data-track="telefon_klick">
          <Icon name="phone" class="w-5 h-5" /> {site.contact.phone}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .abschluss { background: var(--color-cream); }
  .abschluss__box {
    position: relative; overflow: hidden;
    background: var(--gradient-ink);
    border: 1px solid color-mix(in srgb, var(--color-gold) 24%, transparent);
    border-radius: var(--radius-xl);
    padding: clamp(2.5rem, 7vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    box-shadow: var(--shadow-float);
    color: var(--color-onink);
  }
  .abschluss__glow {
    position: absolute; top: -40%; left: 50%; transform: translateX(-50%);
    width: 36rem; height: 26rem; max-width: 120%;
    background: radial-gradient(circle, rgba(230,178,90,0.3), transparent 68%); pointer-events: none;
  }
  .abschluss__eyebrow { position: relative; }
  .abschluss__title { position: relative; color: #fff; font-size: clamp(2.1rem, 5vw, 3.4rem); margin-top: 0.7rem; }
  .abschluss__lead { position: relative; max-width: 48ch; margin: 1rem auto 0; color: var(--color-onink-soft); font-size: 1.05rem; }
  .abschluss__actions { position: relative; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2.25rem; }
  .abschluss__btn { flex: 1 1 auto; }
  @media (min-width: 560px) { .abschluss__btn { flex: 0 0 auto; } }

</style>
