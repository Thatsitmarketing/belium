---
/**
 * Behandlung / Technik im Detail – dunkle Showcase-Sektion (Ref-Stil "Beauty in every detail").
 * Grosses driftendes Hintergrundwort + echtes Geraetefoto mit nummerierten Hotspots,
 * die eine Live-Detailkarte mit ehrlichen technischen Eigenschaften steuern.
 */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import geraet from '@/assets/images/vikini-diodenlaser-handstueck-808nm-belium-gelsenkirchen.png';

type Spot = { n: string; x: number; y: number; titel: string; text: string };
const spots: Spot[] = [
  { n: '01', x: 62, y: 70, titel: 'Saphir-Kontaktkühlung', text: 'Die gekühlte Saphirspitze schützt die Hautoberfläche im selben Moment, in dem der Impuls die Haarwurzel erreicht – spürbar angenehmer als Waxing.' },
  { n: '02', x: 45, y: 15, titel: '808 nm Wellenlänge', text: 'Die Kernwellenlänge des Diodenlasers zielt gezielt auf das Pigment der Haarwurzel und schont das umliegende Gewebe.' },
  { n: '03', x: 10, y: 49, titel: 'Live-Fluenz-Anzeige', text: 'Energie (z. B. 26 J/cm²) wird pro Zone und Hauttyp individuell eingestellt und am Touchscreen kontrolliert.' },
  { n: '04', x: 29, y: 40, titel: 'Taktung bis 10 Hz', text: 'Die schnelle Impulsfolge macht auch größere Zonen in kurzer, gut auszuhaltender Sitzungszeit möglich.' },
  { n: '05', x: 56, y: 42, titel: 'Ergonomisches Handstück', text: 'Präzise Führung von der feinen Oberlippe bis zur Bikinizone oder zum großflächigen Rücken.' },
  { n: '06', x: 58, y: 24, titel: 'Großer Behandlungskopf', text: 'Der 12 × 11 mm Spot arbeitet großflächige Zonen zügig ab – ohne unbehandelte Lücken.' },
];
---
<section id="behandlungen" class="behandlungen">
  <span class="behandlungen__bgword" data-driftx="10" aria-hidden="true">Präzision im Detail</span>

  <div class="container-page behandlungen__inner">
    <header class="behandlungen__head" data-reveal="up">
      <p class="t-eyebrow t-eyebrow--on-dark">Die Behandlung</p>
      <h2 class="t-h2 behandlungen__title">Technik, die man <span class="text-gold--on-dark">im Detail</span> spürt</h2>
      <p class="behandlungen__lead">
        Tippe die Punkte an und sieh, was den gekühlten VIKINI&nbsp;Diodenlaser für deine
        Haut so angenehm und wirksam macht.
      </p>
    </header>

    <div class="behandlungen__stage" data-reveal="up">
      <div class="hs" data-hotspots>
        <div class="hs__media">
          <Image
            src={geraet}
            alt="Gekühlter VIKINI Diodenlaser mit Touchscreen bei der Behandlung"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1000px) 62vw, 92vw"
            loading="lazy"
            format="avif"
            quality={62}
            class="hs__img"
          />
          <div class="hs__scrim" aria-hidden="true"></div>

          {spots.map((s, i) => (
            <button
              type="button"
              class={`hs__dot${i === 0 ? ' is-active' : ''}`}
              style={`left:${s.x}%; top:${s.y}%`}
              data-spot={i}
              data-titel={s.titel}
              data-text={s.text}
              data-n={s.n}
              aria-label={`${s.n} – ${s.titel}`}
            >
              <span class="hs__dot-n">{s.n}</span>
              <span class="hs__dot-ring" aria-hidden="true"></span>
            </button>
          ))}
        </div>

        <!-- Live-Detailkarte -->
        <div class="hs__card" data-hs-card aria-live="polite">
          <span class="hs__card-n" data-hs-n>{spots[0].n}</span>
          <h3 class="hs__card-title" data-hs-title>{spots[0].titel}</h3>
          <p class="hs__card-text" data-hs-text>{spots[0].text}</p>
          <a href="#preise" class="hs__card-link" data-track="cta_behandlung">
            Zonen &amp; Preise ansehen <Icon name="arrow-up-right" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .behandlungen {
    position: relative; overflow: hidden;
    background: var(--gradient-ink); color: var(--color-onink);
    padding-block: clamp(4rem, 8vw, 7.5rem);
    isolation: isolate;
  }
  .behandlungen__bgword {
    position: absolute; z-index: 0; top: 3.5rem; left: 50%; translate: -50% 0;
    white-space: nowrap; pointer-events: none; user-select: none;
    font-family: var(--font-display); font-weight: 700; font-style: italic;
    font-size: clamp(4rem, 15vw, 13rem); line-height: 1;
    color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, var(--color-gold) 26%, transparent);
    opacity: 0.5;
  }
  .behandlungen__inner { position: relative; z-index: 1; }

  .behandlungen__head { max-width: 42rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .behandlungen__title { color: #fff; margin-top: 0.6rem; }
  .behandlungen__lead { margin-top: 0.9rem; color: var(--color-onink-soft); font-size: 1.05rem; max-width: 40ch; }

  /* Hotspot-Bereich */
  .hs { position: relative; }
  .hs__media {
    position: relative; border-radius: var(--radius-lg); overflow: hidden;
    aspect-ratio: 3 / 2; box-shadow: var(--shadow-float);
    border: 1px solid color-mix(in srgb, var(--color-gold) 18%, transparent);
  }
  .hs__img { width: 100%; height: 100%; object-fit: cover; }
  .hs__scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(120deg, rgba(15,11,8,0.55) 0%, rgba(15,11,8,0.12) 45%, transparent 70%);
  }

  .hs__dot {
    position: absolute; z-index: 3; translate: -50% -50%;
    width: 2.2rem; height: 2.2rem; border-radius: 50%; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--color-ink) 55%, transparent);
    backdrop-filter: blur(4px);
    border: 1.5px solid color-mix(in srgb, var(--color-gold) 60%, transparent);
    color: var(--color-gold-light); font-size: 0.72rem; font-weight: 800;
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }
  .hs__dot:hover, .hs__dot.is-active {
    background: var(--gradient-gold); color: #2a1c07; border-color: transparent;
    transform: translate(-50%, -50%) scale(1.12);
  }
  .hs__dot-ring {
    position: absolute; inset: -6px; border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
    animation: hs-pulse 2.4s ease-out infinite;
  }
  .hs__dot.is-active .hs__dot-ring { border-color: color-mix(in srgb, var(--color-gold) 70%, transparent); }
  @keyframes hs-pulse { 0% { transform: scale(0.8); opacity: 0.9; } 100% { transform: scale(1.7); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hs__dot-ring { animation: none; } }

  .hs__card {
    position: relative; z-index: 4;
    margin-top: 1.2rem;
    background: color-mix(in srgb, var(--color-ink-2) 92%, #000);
    border: 1px solid color-mix(in srgb, var(--color-gold) 26%, transparent);
    border-radius: var(--radius-md); padding: 1.5rem 1.6rem;
    box-shadow: var(--shadow-float);
  }
  .hs__card-n { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--color-gold); letter-spacing: 0.1em; }
  .hs__card-title { color: #fff; font-size: 1.5rem; margin-top: 0.15rem; }
  .hs__card-text { margin-top: 0.55rem; color: var(--color-onink-soft); font-size: 0.98rem; max-width: 52ch; }
  .hs__card-link {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1rem;
    font-weight: 700; font-size: 0.9rem; color: var(--color-gold-light); text-decoration: none;
  }
  .hs__card-link :global(svg) { transition: transform 0.2s ease; }
  .hs__card-link:hover :global(svg) { transform: translate(2px, -2px); }

  /* Desktop: Karte schwebt unten links ueber dem Bild */
  @media (min-width: 1000px) {
    .hs__media { aspect-ratio: 16 / 9; }
    .hs__card {
      position: absolute; left: 1.5rem; bottom: 1.5rem; margin-top: 0;
      max-width: 25rem; backdrop-filter: blur(8px);
      background: color-mix(in srgb, var(--color-ink) 82%, transparent);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hotspots]');
  if (root) {
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.hs__dot'));
    const nEl = root.querySelector<HTMLElement>('[data-hs-n]');
    const tEl = root.querySelector<HTMLElement>('[data-hs-title]');
    const xEl = root.querySelector<HTMLElement>('[data-hs-text]');

    const activate = (dot: HTMLButtonElement) => {
      dots.forEach((d) => d.classList.remove('is-active'));
      dot.classList.add('is-active');
      if (nEl) nEl.textContent = dot.dataset.n || '';
      if (tEl) tEl.textContent = dot.dataset.titel || '';
      if (xEl) xEl.textContent = dot.dataset.text || '';
    };

    dots.forEach((dot) => {
      dot.addEventListener('mouseenter', () => activate(dot));
      dot.addEventListener('focus', () => activate(dot));
      dot.addEventListener('click', () => activate(dot));
    });
  }
</script>
