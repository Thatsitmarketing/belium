---
/**
 * Bewertungen – horizontale Kartenreihe, die eine dunkle Bande ueberlappt (Ref-Stil).
 * Inhalte aus src/data/reviews.ts (PLATZHALTER, siehe dortige Hinweise) – vor Livegang
 * durch echte, freigegebene Bewertungen oder das Google/ProvenExpert-Widget ersetzen.
 */
import Icon from '@/components/Icon.astro';
import Ornament from '@/components/Ornament.astro';
import { reviews, reviewsPlatzhalter } from '@/data/reviews';
---
<section id="bewertungen" class="rev">
  <div class="container-page rev__head" data-reveal="up">
    <Ornament class="rev__ornament" />
    <p class="t-eyebrow t-eyebrow--center">Kundenstimmen</p>
    <h2 class="t-h2">Das sagen <span class="text-gold">unsere Kundinnen &amp; Kunden</span></h2>
  </div>

  <div class="rev__stage">
    <div class="rev__band" aria-hidden="true"></div>
    <ul class="rev__track" data-rev-track>
      {reviews.map((r) => (
        <li class="rev__item">
          <article class="rcard">
            <span class="rcard__quote" aria-hidden="true"><Icon name="quote" class="w-6 h-6" /></span>
            <div class="rcard__stars" role="img" aria-label={`${r.stars} von 5 Sternen`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <Icon name="star" class={`w-4 h-4 rcard__star${i < r.stars ? ' is-on' : ''}`} />
              ))}
            </div>
            <p class="rcard__text">{r.text}</p>
            <footer class="rcard__foot">
              <span class="rcard__avatar" aria-hidden="true">{r.name.charAt(0)}</span>
              <span class="rcard__meta">
                <span class="rcard__name">{r.name}</span>
                <span class="rcard__zone">{r.zone}</span>
              </span>
            </footer>
          </article>
        </li>
      ))}
    </ul>
  </div>

  <div class="container-page rev__foot" data-reveal="up">
    {reviewsPlatzhalter && (
      <p class="rev__note">
        <Icon name="info" class="w-4 h-4" /> Beispielhafte Stimmen zur Ansicht – echte Google- &amp; ProvenExpert-Bewertungen binden wir nach Freigabe ein.
      </p>
    )}
    <div class="rev__links">
      <a href="https://www.google.com/search?q=Belium+Beauty+Gelsenkirchen+Buer" target="_blank" rel="noopener" class="btn btn-ghost">Bei Google ansehen</a>
      <a href="https://www.provenexpert.com/" target="_blank" rel="noopener" class="btn btn-ghost">ProvenExpert</a>
    </div>
  </div>
</section>

<style>
  .rev { background: var(--color-cream-deep); padding-block: clamp(3.75rem, 8vw, 7rem); overflow: hidden; }
  .rev__head { text-align: center; max-width: 46rem; margin-inline: auto; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .rev :global(.rev__ornament) { margin-bottom: 1rem; }
  .rev__head .t-h2 { margin-top: 0.7rem; }

  .rev__stage { position: relative; }
  /* dunkle Bande, die die Kartenunterkante hinterlegt */
  .rev__band {
    position: absolute; left: 0; right: 0; bottom: 0; height: 46%;
    background: var(--gradient-ink);
  }

  .rev__track {
    position: relative; z-index: 1;
    list-style: none; display: flex; gap: 1.15rem;
    overflow-x: auto; scroll-snap-type: x proximity; scroll-behavior: smooth;
    padding-block: 0.5rem 2.4rem;
    padding-inline: max(1.25rem, 10%);
    -ms-overflow-style: none; scrollbar-width: none; cursor: grab;
  }
  .rev__track::-webkit-scrollbar { display: none; }
  .rev__track.is-dragging { cursor: grabbing; scroll-behavior: auto; scroll-snap-type: none; }

  .rev__item { flex: 0 0 84%; scroll-snap-align: start; }
  @media (min-width: 620px) { .rev__item { flex-basis: 46%; } }
  @media (min-width: 1000px) { .rev__item { flex-basis: 31%; } }
  @media (min-width: 1280px) { .rev__item { flex-basis: 27%; } }

  .rcard {
    position: relative; height: 100%;
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--color-sand);
    border-radius: var(--radius-lg); padding: 1.7rem 1.6rem 1.5rem;
    box-shadow: var(--shadow-card);
    transition: transform 0.28s cubic-bezier(0.22,1,0.36,1), box-shadow 0.28s ease;
  }
  .rcard:hover { transform: translateY(-5px); box-shadow: var(--shadow-float); }
  .rcard__quote {
    position: absolute; top: 1.3rem; right: 1.4rem;
    color: color-mix(in srgb, var(--color-gold) 45%, transparent);
  }
  .rcard__stars { display: inline-flex; gap: 0.15rem; margin-bottom: 0.85rem; }
  .rcard__stars :global(.rcard__star) { color: var(--color-sand-deep); }
  .rcard__stars :global(.rcard__star.is-on) { color: var(--color-gold); }
  .rcard__text { color: var(--color-ink-soft); font-size: 0.98rem; line-height: 1.6; flex: 1 1 auto; }
  .rcard__foot { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px solid var(--color-sand); }
  .rcard__avatar {
    flex: 0 0 auto; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: #fff;
    background: var(--gradient-gold);
  }
  .rcard__meta { display: flex; flex-direction: column; line-height: 1.3; }
  .rcard__name { font-weight: 700; color: var(--color-ink); }
  .rcard__zone { font-size: 0.82rem; color: var(--color-mocha); }

  .rev__foot { text-align: center; margin-top: 0.5rem; }
  .rev__note {
    display: inline-flex; align-items: center; gap: 0.45rem; justify-content: center;
    color: var(--color-mocha); font-size: 0.85rem; margin-bottom: 1.1rem;
  }
  .rev__note :global(svg) { color: var(--color-gold-deep); flex: 0 0 auto; }
  .rev__links { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-rev-track]');
  if (track) {
    let down = false, startX = 0, startLeft = 0, moved = 0;
    track.addEventListener('pointerdown', (e) => {
      down = true; moved = 0; startX = e.clientX; startLeft = track.scrollLeft;
      track.classList.add('is-dragging');
    });
    track.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX; moved = Math.max(moved, Math.abs(dx));
      track.scrollLeft = startLeft - dx;
    });
    const end = () => { down = false; track.classList.remove('is-dragging'); };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointerleave', end);
    track.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); e.stopPropagation(); } }, true);
  }
</script>
