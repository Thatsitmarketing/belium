---
/**
 * Bewertungen – durchlaufendes Kundenstimmen-Karussell (Marquee) auf heller Fläche.
 * Die Karten laufen endlos und gleichmäßig nach links; es gibt bewusst KEINE Punkt- oder
 * Pfeil-Navigation. Der Lauf basiert auf einem nativen Scroll-Container, damit Wischen
 * (Touch), Trackpad und Maus-Drag ohne Umwege funktionieren – während der Bedienung pausiert
 * der Lauf und setzt danach nahtlos fort. Die Kartenliste ist verdoppelt, der Scroll springt
 * bei Halbzeit unsichtbar zurück (Endlosschleife).
 * Inhalte aus src/data/reviews.ts – echte, wörtlich übernommene Google-Rezensionen.
 * Der Hinweis unter dem Streifen erscheint nur noch, solange `reviewsPlatzhalter` true ist.
 */
import Icon from '@/components/Icon.astro';
import Ornament from '@/components/Ornament.astro';
import { reviews, reviewsPlatzhalter } from '@/data/reviews';

// Für die Endlosschleife läuft die Liste zweimal durch: der zweite Durchgang ist eine reine
// optische Kopie (aria-hidden), damit Screenreader die Stimmen nur einmal vorlesen.
const track = [...reviews, ...reviews];
---
<section id="bewertungen" class="rev">
  <div class="rev__head" data-reveal="up">
    <Ornament class="rev__ornament" />
    <p class="t-eyebrow t-eyebrow--center">Kundenstimmen</p>
    <h2 class="t-h2 rev__title">Das sagen <span class="text-gold">unsere Kundinnen</span></h2>
  </div>

  <div class="rev__slider" data-rev>
    <ul
      class="rev__viewport"
      data-rev-viewport
      tabindex="0"
      role="region"
      aria-roledescription="Karussell"
      aria-label="Kundenstimmen, seitlich wischbar"
    >
      {track.map((r, i) => (
        <li
          class="rev__item"
          data-rev-item
          aria-hidden={i >= reviews.length ? 'true' : undefined}
        >
          <article class="rcard">
            <span class="rcard__quote" aria-hidden="true"><Icon name="quote" class="w-6 h-6" /></span>
            <div class="rcard__stars" role="img" aria-label={`${r.stars} von 5 Sternen`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <Icon name="star" class={`w-4 h-4 rcard__star${s < r.stars ? ' is-on' : ''}`} />
              ))}
            </div>
            <p class="rcard__text">{r.text}</p>
            <footer class="rcard__foot">
              <span class="rcard__avatar" aria-hidden="true">{r.name.charAt(0)}</span>
              <span class="rcard__meta">
                <span class="rcard__name">{r.name}</span>
                <span class="rcard__zone">{r.quelle}</span>
              </span>
            </footer>
          </article>
        </li>
      ))}
    </ul>
  </div>

  <div class="container-page rev__foot" data-reveal="up">
    {reviewsPlatzhalter && (
      <p class="rev__note">
        <Icon name="info" class="w-4 h-4" /> Beispielhafte Stimmen zur Ansicht. Echte Google-Bewertungen binden wir nach Freigabe ein.
      </p>
    )}
    <div class="rev__links">
      <a href="https://www.google.com/search?q=Belium+Beauty+Gelsenkirchen+Buer" target="_blank" rel="noopener" class="btn btn-ghost">
        <svg class="rev__glogo" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
          <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
          <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
          <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
          <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
        </svg>
        Bei Google ansehen
      </a>
    </div>
  </div>
</section>

<style>
  .rev { background: var(--color-cream-deep); padding-block: clamp(3.75rem, 8vw, 7rem); overflow: hidden; }
  /* Headline breit & zusammengeführt: eigener, moderater Innenabstand statt der
     viewport-prozentualen container-page-Polsterung (die auf breiten Screens zu
     stark einschnürte und die Überschrift in viele kurze Zeilen brach). */
  .rev__head { text-align: center; max-width: 54rem; margin-inline: auto; padding-inline: 1.5rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .rev :global(.rev__ornament) { margin-bottom: 1rem; }
  .rev__head .rev__title { margin-top: 0.7rem; text-wrap: balance; }

  /* Durchlaufendes Karussell: nativer Scroll-Container (Touch/Trackpad/Drag) ohne Snap,
     damit der Lauf nicht bei jeder Karte einrastet. Bewegung kommt aus dem Script. */
  .rev__slider { position: relative; }
  /* Weiche Kanten, damit die Karten am Rand ein-/ausblenden statt hart abzuschneiden. */
  @media (min-width: 700px) {
    .rev__slider {
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6rem, #000 calc(100% - 6rem), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 6rem, #000 calc(100% - 6rem), transparent 100%);
    }
  }
  .rev__viewport {
    list-style: none; display: flex; gap: 1.15rem;
    overflow-x: auto; overscroll-behavior-x: contain;
    scrollbar-width: none; -ms-overflow-style: none;
    padding-block: 0.5rem 1.5rem;
    padding-inline: 1.25rem;
    cursor: grab;
    -webkit-overflow-scrolling: touch;
  }
  .rev__viewport::-webkit-scrollbar { display: none; }
  .rev__viewport.is-dragging { cursor: grabbing; user-select: none; }
  .rev__viewport:focus-visible { outline: 3px solid var(--color-gold); outline-offset: -3px; border-radius: var(--radius-md); }

  .rev__item { flex: 0 0 clamp(17rem, 78vw, 20.5rem); }
  @media (min-width: 700px) { .rev__item { flex-basis: clamp(18rem, 30vw, 20.5rem); } }

  .rcard {
    position: relative; height: 100%;
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--color-sand);
    border-radius: var(--radius-lg); padding: 1.7rem 1.6rem 1.5rem;
    box-shadow: var(--shadow-card);
    transition: transform 0.28s cubic-bezier(0.22,1,0.36,1), box-shadow 0.28s ease;
  }
  .rcard:hover { transform: translateY(-5px); box-shadow: var(--shadow-float); }
  .rcard__quote {
    position: absolute; top: 1.3rem; right: 1.4rem;
    color: color-mix(in srgb, var(--color-gold) 45%, transparent);
  }
  .rcard__stars { display: inline-flex; gap: 0.15rem; margin-bottom: 0.85rem; }
  .rcard__stars :global(.rcard__star) { color: var(--color-sand-deep); }
  .rcard__stars :global(.rcard__star.is-on) { color: var(--color-gold); }
  .rcard__text { color: var(--color-ink-soft); font-size: 0.98rem; line-height: 1.6; flex: 1 1 auto; }
  .rcard__foot { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px solid var(--color-sand); }
  .rcard__avatar {
    flex: 0 0 auto; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: #fff;
    background: var(--gradient-gold);
  }
  .rcard__meta { display: flex; flex-direction: column; line-height: 1.3; }
  .rcard__name { font-weight: 700; color: var(--color-ink); }
  .rcard__zone { font-size: 0.82rem; color: var(--color-mocha); }

  .rev__foot { text-align: center; margin-top: 0.5rem; }
  .rev__note {
    display: inline-flex; align-items: center; gap: 0.45rem; justify-content: center;
    color: var(--color-mocha); font-size: 0.85rem; margin-bottom: 1.1rem;
  }
  .rev__note :global(svg) { color: var(--color-gold-deep); flex: 0 0 auto; }
  .rev__links { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  .rev__glogo { flex: 0 0 auto; display: block; }
</style>

<script>
  /**
   * Marquee-Steuerung: Der Scroll-Container bleibt die Quelle der Wahrheit – der Lauf schiebt
   * `scrollLeft` pro Frame ein Stück weiter. Weil die Kartenliste doppelt im DOM steht, kann
   * nach einer vollen Runde unsichtbar zurückgesprungen werden. Eigene Bedienung (Wischen,
   * Trackpad, Maus-Drag, Hover, Fokus) pausiert den Lauf; danach läuft er ab der aktuellen
   * Position weiter. Ohne JS bleibt der Abschnitt ein normal scrollbarer Kartenstreifen.
   */
  const slider = document.querySelector<HTMLElement>('[data-rev]');
  const viewport = slider?.querySelector<HTMLElement>('[data-rev-viewport]') ?? null;
  const items = slider ? Array.from(slider.querySelectorAll<HTMLElement>('[data-rev-item]')) : [];

  if (slider && viewport && items.length >= 2) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    /** Lauftempo in Pixeln pro Sekunde – bewusst ruhig, damit der Text lesbar bleibt. */
    const SPEED = 32;
    /** Wartezeit, bis der Lauf nach eigener Bedienung wieder anspringt. */
    const RESUME_MS = 2500;

    let pos = viewport.scrollLeft;
    let lastSet = pos;
    let lastTs = 0;
    let raf = 0;
    let holds = 0;            // Hover/Fokus: solange > 0 steht der Lauf
    let pauseBis = 0;         // Zeitstempel, bis zu dem eine Bedienung nachwirkt
    let sichtbar = true;
    let dragging = false;
    let dragId = -1;

    /** Länge einer vollen Runde: Abstand zwischen Original und seiner Kopie. */
    function loopWidth() {
      const kopie = items[items.length >> 1];
      return kopie ? kopie.offsetLeft - items[0].offsetLeft : 0;
    }

    function laufen(ts: number) {
      return !holds && !dragging && ts >= pauseBis
        && sichtbar && !document.hidden && !reducedMotion.matches;
    }

    /** Bedienung wirkt kurz nach, damit der Lauf einem nicht sofort in die Hand fährt. */
    function verzoegern() {
      pauseBis = performance.now() + RESUME_MS;
    }
    function halten() { holds += 1; }
    function loslassen() { holds = Math.max(0, holds - 1); }

    function frame(ts: number) {
      raf = window.requestAnimationFrame(frame);
      const dt = lastTs ? Math.min((ts - lastTs) / 1000, 0.1) : 0;
      lastTs = ts;
      const aktiv = laufen(ts);

      const ist = viewport!.scrollLeft;
      // Hat jemand selbst gescrollt/gewischt? Dann von dort weiterrechnen.
      if (Math.abs(ist - lastSet) > 1) pos = ist;

      if (aktiv) pos += SPEED * dt;

      // Endlosschleife: nach einer Runde unsichtbar auf die identische Kopie zurücksetzen.
      const runde = loopWidth();
      let gesprungen = false;
      if (runde > 0) {
        while (pos >= runde) { pos -= runde; gesprungen = true; }
        while (pos < 0) { pos += runde; gesprungen = true; }
      }

      if (aktiv || gesprungen) {
        viewport!.scrollLeft = pos;
        lastSet = viewport!.scrollLeft;
      } else {
        lastSet = ist;
        pos = ist;
      }
    }

    function start() {
      if (!raf) { lastTs = 0; raf = window.requestAnimationFrame(frame); }
    }
    function stop() {
      if (raf) { window.cancelAnimationFrame(raf); raf = 0; }
    }

    // Hover und Tastaturfokus halten den Lauf an, solange man dranbleibt.
    slider.addEventListener('pointerenter', halten);
    slider.addEventListener('pointerleave', loslassen);
    slider.addEventListener('focusin', halten);
    slider.addEventListener('focusout', loslassen);

    // Wischen, Trackpad und Mausrad: kurz pausieren, danach weiterlaufen.
    ['touchstart', 'wheel'].forEach((ev) =>
      viewport.addEventListener(ev, verzoegern, { passive: true })
    );
    viewport.addEventListener('keydown', verzoegern);

    // Maus-Drag, damit der Streifen am Desktop genauso greifbar ist wie am Handy.
    viewport.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      dragId = e.pointerId;
      viewport.classList.add('is-dragging');
      viewport.setPointerCapture(e.pointerId);
    });
    viewport.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging || e.pointerId !== dragId) return;
      e.preventDefault();
      viewport.scrollLeft -= e.movementX;
    });
    function dragEnde(e: PointerEvent) {
      if (!dragging || e.pointerId !== dragId) return;
      dragging = false;
      dragId = -1;
      viewport!.classList.remove('is-dragging');
      if (viewport!.hasPointerCapture(e.pointerId)) viewport!.releasePointerCapture(e.pointerId);
      verzoegern();
    }
    viewport.addEventListener('pointerup', dragEnde);
    viewport.addEventListener('pointercancel', dragEnde);

    // Nur laufen lassen, wenn der Abschnitt sichtbar ist bzw. der Tab im Vordergrund steht.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((eintraege) => {
        sichtbar = eintraege.some((e) => e.isIntersecting);
        if (sichtbar) start(); else stop();
      }, { rootMargin: '120px' }).observe(slider);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop(); else start();
    });
    window.addEventListener('resize', () => { lastTs = 0; }, { passive: true });

    start();
  }
</script>
