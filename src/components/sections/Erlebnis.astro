---
/**
 * Editorial-Erlebnisgalerie – inspiriert von der horizontalen Serif-Galerie der Referenz
 * („Feel renewed, from the first visit"): hohe, abgerundete Hochkant-Bilder in einer Reihe,
 * jeweils mit großem Serif-Label. Rein emotional/visuell, kein CTA.
 */
import { Image } from 'astro:assets';
import Ornament from '@/components/Ornament.astro';
import glatt from '@/assets/images/erlebnis-glatt-beine-belium.png';
import sanft from '@/assets/images/erlebnis-sanft-achseln-belium.png';
import sicher from '@/assets/images/erlebnis-sicher-entspannt-belium.png';
import muehelos from '@/assets/images/erlebnis-muehelos-schulter-belium.png';

const karten = [
  { src: glatt, label: 'Glatt', text: 'Dauerhaft weniger Nachwuchs, spürbar glatte Haut.', alt: 'Glatte, hautschonend behandelte Beine im warmen Studiolicht' },
  { src: sanft, label: 'Sanft', text: 'Gekühlte Behandlung – angenehm statt schmerzhaft.', alt: 'Frau mit glatter, hautschonend behandelter Achsel' },
  { src: sicher, label: 'Sicher', text: 'Zertifiziert begleitet, individuell eingestellt.', alt: 'Entspannte Frau mit geschlossenen Augen während einer ruhigen Behandlung' },
  { src: muehelos, label: 'Mühelos', text: 'Schluss mit dem täglichen Rasieren.', alt: 'Glatte Schulter und Rücken mit gepflegter Haut in warmem Licht' },
];
---
<section id="erlebnis" class="erlebnis">
  <div class="container-page erlebnis__head" data-reveal="up">
    <Ornament class="erlebnis__ornament" />
    <h2 class="erlebnis__title">Fühl dich erneuert –<br />vom ersten Termin an</h2>
  </div>

  <ul class="erlebnis__strip" data-reveal-stagger>
    {karten.map((k) => (
      <li class="ecard" data-reveal="up">
        <div class="ecard__media">
          <Image
            src={k.src}
            alt={k.alt}
            widths={[360, 560, 760]}
            sizes="(min-width: 1000px) 26vw, 92vw"
            loading="lazy"
            format="avif"
            quality={64}
            class="ecard__img"
          />
        </div>
        <div class="ecard__body">
          <h3 class="ecard__label">{k.label}</h3>
          <p class="ecard__text">{k.text}</p>
        </div>
      </li>
    ))}
  </ul>

  <div class="container-page erlebnis__cta">
    <div class="section-cta reveal">
      <a href="#kontakt" class="btn btn-primary" data-track="cta_erlebnis">Kostenlose Beratung anfragen</a>
    </div>
  </div>
</section>

<style>
  .erlebnis { background: var(--color-cream); padding-block: clamp(3.75rem, 8vw, 7rem); overflow: hidden; }

  .erlebnis__head { margin-bottom: clamp(1.75rem, 4vw, 2.75rem); }
  .erlebnis :global(.erlebnis__ornament) { margin-inline: 0; width: 6.5rem; margin-bottom: 1.1rem; }
  .erlebnis__title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2.2rem, 5.5vw, 4rem); line-height: 1.04;
    letter-spacing: 0.01em; text-transform: uppercase; color: var(--color-gold-deep);
  }

  /* Mobil & Tablet: Karten untereinander (mit Scroll-Reveal über [data-reveal]) */
  .erlebnis__strip {
    list-style: none; display: grid; grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    padding-inline: max(1.25rem, 15%); padding-block: 0.25rem;
  }
  @media (max-width: 640px) { .erlebnis__strip { padding-inline: 1.5rem; } }

  /* Desktop: zentrierte Galerie – alle Bilder auf einen Blick, mittig gesetzt */
  @media (min-width: 1000px) {
    .erlebnis__strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.6rem);
      justify-content: center; align-items: start;
    }
  }

  .erlebnis__cta { margin-top: clamp(1.5rem, 3vw, 2.25rem); }

  .ecard__media {
    border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 3 / 2;
    box-shadow: var(--shadow-card); border: 1px solid var(--color-sand);
    background: var(--color-sand);
  }
  @media (min-width: 1000px) { .ecard__media { aspect-ratio: 3 / 4; } }
  .ecard__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.22,1,0.36,1); }
  .ecard:hover .ecard__img { transform: scale(1.04); }

  .ecard__label {
    margin-top: 1rem; font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem); text-transform: uppercase; letter-spacing: 0.02em;
    color: var(--color-gold-deep);
  }
  .ecard__text { margin-top: 0.25rem; color: var(--color-mocha); font-size: 0.92rem; max-width: 26ch; }
</style>
