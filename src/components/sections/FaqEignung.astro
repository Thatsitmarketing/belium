---
/**
 * Zusammengeführt: Eignungscheck (früher „Sicherheit"/Ausschlusskriterien) + FAQ-Akkordeon.
 * Oben ein kompakter Eignungscheck (geeignet / eingeschränkt), darunter die häufigsten Fragen.
 * Die FAQ werden weiterhin im FAQPage-JSON-LD gespiegelt (src/data/faq.ts).
 */
import { faqItems } from '@/data/faq';
import Icon from '@/components/Icon.astro';
import Ornament from '@/components/Ornament.astro';

const geeignet = [
  'Dunklere Haare',
  'Helle bis mittlere Hauttypen',
  'Regelmäßig störender Haarwuchs',
];
const eingeschraenkt = [
  'Weiße, graue oder sehr hellblonde Haare',
  'Schwangerschaft oder Stillzeit',
  'Frische Bräune oder Sonnenbrand',
  'Bestimmte Medikamente',
  'Bestimmte Hauterkrankungen',
  'Tattoos direkt in der Behandlungszone',
];
---
<section id="faq" class="section-pad faqe">
  <div class="container-page">
    <header class="section-head reveal">
      <Ornament />
      <p class="t-eyebrow">Eignung &amp; FAQ</p>
      <h2 class="t-h2">Ist die Laserbehandlung <span class="text-gold">für mich geeignet?</span></h2>
      <p class="t-lead section-head__lead">
        Wir sind ehrlich: Nicht für jeden ist die Behandlung sinnvoll. Links siehst du auf einen Blick,
        wann sie gut funktioniert – rechts beantworten wir die häufigsten Fragen.
      </p>
    </header>

    <div class="fe__grid">
      <!-- Links: Eignung -->
      <div class="fe__eignung">
        <article class="eignung__col eignung__col--ja">
          <h3 class="eignung__h"><span class="eignung__badge eignung__badge--ja"><Icon name="check" class="w-4 h-4" /></span> Häufig gut geeignet</h3>
          <ul class="eignung__list">
            {geeignet.map((g) => (
              <li><Icon name="check-circle" class="w-5 h-5 eignung__ic eignung__ic--ja" />{g}</li>
            ))}
          </ul>
        </article>

        <article class="eignung__col eignung__col--nein">
          <h3 class="eignung__h"><span class="eignung__badge eignung__badge--nein"><Icon name="info" class="w-4 h-4" /></span> Nicht oder nur eingeschränkt</h3>
          <ul class="eignung__list">
            {eingeschraenkt.map((e) => (
              <li><Icon name="info" class="w-5 h-5 eignung__ic eignung__ic--nein" />{e}</li>
            ))}
          </ul>
        </article>
      </div>

      <!-- Rechts: FAQ (Top 6) -->
      <div class="fe__faq">
        {faqItems.slice(0, 6).map((item, i) => (
          <details class="faq__item" name="faq" open={i === 0}>
            <summary class="faq__summary">
              <h3 class="faq__frage">{item.frage}</h3>
              <span class="faq__icon"><Icon name="chevron" class="w-5 h-5" /></span>
            </summary>
            <div class="faq__antwort"><p>{item.antwort}</p></div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faqe { background: var(--color-cream); }

  /* Zweispaltiger, linksbündiger Aufbau: links Eignung, rechts FAQ. Mobil untereinander. */
  .fe__grid { display: grid; grid-template-columns: 1fr; gap: clamp(1.5rem, 3vw, 2.5rem); align-items: start; }
  @media (min-width: 900px) { .fe__grid { grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3rem); } }

  /* Eignungscheck (links) */
  .fe__eignung { display: flex; flex-direction: column; gap: 1.25rem; }
  .eignung__col { border-radius: var(--radius-lg); padding: 1.75rem 1.6rem; border: 1px solid var(--color-sand); background: #fff; box-shadow: var(--shadow-soft); }
  .eignung__col--ja { border-color: color-mix(in srgb, var(--color-gold) 34%, var(--color-sand)); }
  .eignung__h { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-sans); font-size: 1rem; font-weight: 800; margin-bottom: 1.1rem; }
  .eignung__badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.9rem; height: 1.9rem; border-radius: 50%; flex: 0 0 auto;
  }
  .eignung__badge--ja { color: #2a1c07; background: var(--gradient-gold); }
  .eignung__badge--nein { color: var(--color-rose); background: color-mix(in srgb, var(--color-rose) 15%, #fff); }
  .eignung__list { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }
  .eignung__list li { display: flex; align-items: flex-start; gap: 0.6rem; font-weight: 600; font-size: 0.96rem; color: var(--color-ink-soft); }
  .eignung__ic { flex: 0 0 auto; margin-top: 0.1rem; }
  .eignung__ic--ja { color: var(--color-gold-deep); }
  .eignung__ic--nein { color: var(--color-rose); }

  /* FAQ (rechts) */
  .fe__faq { display: flex; flex-direction: column; gap: 0.6rem; }
  .faq__item { background: #fff; border: 1px solid var(--color-sand); border-radius: var(--radius-md); overflow: hidden; }
  .faq__item[open] { border-color: var(--color-gold-soft); box-shadow: var(--shadow-soft); }
  .faq__summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.1rem 1.25rem; cursor: pointer; list-style: none;
  }
  .faq__summary::-webkit-details-marker { display: none; }
  .faq__frage { font-size: 1.1rem; font-weight: 600; }
  .faq__icon { flex: 0 0 auto; color: var(--color-gold-deep); transition: transform 0.25s ease; }
  .faq__item[open] .faq__icon { transform: rotate(180deg); }
  .faq__antwort { padding: 0 1.25rem 1.25rem; color: var(--color-ink-soft); font-size: 0.97rem; }
  @media (prefers-reduced-motion: no-preference) {
    .faq__antwort { animation: faq-in 0.3s ease; }
    @keyframes faq-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  }
</style>
