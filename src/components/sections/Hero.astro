---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { telLink } from '@/data/site';
import heroImg from '@/assets/images/behandlungsraum-belium-gelsenkirchen-buer.png';

const trust = [
  { icon: 'shield', text: 'Zertifizierte Laserschutzbeauftragte' },
  { icon: 'droplet', text: 'Gekühlter Diodenlaser, schmerzarm' },
  { icon: 'map-pin', text: 'Mitten in Gelsenkirchen Buer' },
];
---
<section id="hero" class="hero grain" data-hero>
  <!-- Vollflaechiges, optimiertes Hintergrundbild -->
  <div class="hero__bg" aria-hidden="true">
    <Image
      src={heroImg}
      alt=""
      widths={[768, 1200, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      format="avif"
      quality={62}
      class="hero__bg-img"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="container-page hero__inner">
    <div class="hero__content">
      <p class="pill pill--on-dark hero__pill" data-hero-el>
        <Icon name="spark" class="w-4 h-4" gradient /> Dauerhafte Laser Haarentfernung
      </p>

      <h1 class="hero__title">
        <span class="hero__line" data-hero-line>Dauerhaft glatte Haut.</span>
        <span class="hero__line hero__line--accent" data-hero-line>Ganz ohne Rasieren.</span>
      </h1>

      <p class="hero__lead" data-hero-el>
        Mit dem gekühlten VIKINI&nbsp;Diodenlaser reduzieren wir deine Haare dauerhaft,
        schmerzarm und begleitet von einer zertifizierten Laserschutzbeauftragten –
        mitten in Gelsenkirchen&nbsp;Buer.
      </p>

      <div class="hero__actions" data-hero-el>
        <a href="#kontakt" class="btn btn-primary" data-track="cta_hero">Kostenlose Beratung sichern</a>
        <a href="#preise" class="btn btn-ghost btn-ghost--on-dark">
          <Icon name="euro" class="w-5 h-5" /> Preis berechnen
        </a>
      </div>

      <ul class="hero__trust" aria-label="Vertrauensmerkmale" data-hero-el>
        {trust.map((t) => (
          <li class="hero__trust-item">
            <span class="hero__trust-ic"><Icon name={t.icon} class="w-4 h-4" gradient /></span>
            <span>{t.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Floating Info-Karte -->
    <aside class="hero__card" data-hero-el aria-label="Gerätehinweis">
      <div class="hero__card-glow" aria-hidden="true"></div>
      <span class="hero__card-num text-gold">808&nbsp;nm</span>
      <span class="hero__card-label">VIKINI Diodenlaser</span>
      <p class="hero__card-text">Saphir-Kontaktkühlung für ein angenehmes Behandlungsgefühl.</p>
      <a href={telLink()} class="hero__card-call" data-track="telefon_klick">
        <Icon name="phone" class="w-4 h-4" /> Direkt anrufen
      </a>
    </aside>
  </div>

  <a href="#einstieg" class="hero__scroll" aria-label="Weiterscrollen" data-hero-el>
    <span>Entdecken</span>
    <Icon name="arrow-down" class="w-4 h-4" />
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: clamp(6rem, 14vh, 9rem);
    padding-bottom: clamp(4rem, 10vh, 7rem);
    color: var(--color-onink);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg-img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero__overlay {
    position: absolute; inset: 0;
    background:
      radial-gradient(90% 70% at 78% 18%, rgba(230, 178, 90, 0.28) 0%, transparent 55%),
      linear-gradient(120deg, rgba(15, 11, 8, 0.94) 0%, rgba(20, 15, 10, 0.82) 42%, rgba(23, 19, 16, 0.55) 100%),
      linear-gradient(0deg, rgba(15, 11, 8, 0.85) 0%, transparent 45%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    width: 100%;
  }

  .hero__pill { margin-bottom: 1.4rem; }

  .hero__title {
    font-size: clamp(2.7rem, 8vw, 5rem);
    line-height: 1.02;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .hero__line { display: block; }
  .hero__line--accent {
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .hero__lead {
    margin-top: 1.4rem;
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: color-mix(in srgb, var(--color-onink) 92%, #fff);
    line-height: 1.6;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .hero__actions .btn { flex: 1 1 auto; }

  .hero__trust { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; margin-top: 2.25rem; }
  .hero__trust-item { display: flex; align-items: center; gap: 0.7rem; font-weight: 600; font-size: 0.95rem; color: color-mix(in srgb, var(--color-onink) 96%, #fff); }
  .hero__trust-ic {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 1.9rem; height: 1.9rem; border-radius: 50%;
    background: color-mix(in srgb, var(--color-gold) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-gold) 34%, transparent);
  }

  .hero__card {
    position: relative;
    background: color-mix(in srgb, var(--color-ink) 62%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: 1.6rem 1.7rem;
    box-shadow: var(--shadow-float);
    max-width: 22rem;
    overflow: hidden;
  }
  .hero__card-glow {
    position: absolute; top: -40%; right: -30%;
    width: 16rem; height: 16rem; border-radius: 50%;
    background: radial-gradient(circle, rgba(230,178,90,0.4), transparent 70%);
    pointer-events: none;
  }
  .hero__card-num { font-family: var(--font-display); font-weight: 700; font-size: 2.6rem; line-height: 1; display: block; }
  .hero__card-label { font-size: 0.74rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-gold-light); }
  .hero__card-text { margin-top: 0.9rem; font-size: 0.92rem; color: var(--color-onink-soft); }
  .hero__card-call {
    display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 1.1rem;
    font-weight: 700; font-size: 0.9rem; color: var(--color-gold-light);
    text-decoration: none; padding-bottom: 2px; border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
  }
  .hero__card-call:hover { color: #fff; }

  .hero__scroll {
    position: absolute; left: 50%; bottom: 1.4rem; transform: translateX(-50%);
    display: none; flex-direction: column; align-items: center; gap: 0.35rem;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--color-onink-soft); text-decoration: none;
  }
  .hero__scroll :global(svg) { animation: hero-bounce 1.8s ease-in-out infinite; }
  @keyframes hero-bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(5px); } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll :global(svg) { animation: none; } }

  @media (min-width: 560px) {
    .hero__actions .btn { flex: 0 0 auto; }
  }
  @media (min-width: 1024px) {
    .hero__inner { grid-template-columns: 1.35fr 0.65fr; gap: 3.5rem; }
    .hero__card { justify-self: end; }
    .hero__scroll { display: flex; }
  }
</style>
