---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import heroImg from '@/assets/images/maria-espejo-belium-beauty-gelsenkirchen.png';

/**
 * Hero – heller, editorialer Split:
 * links Headline + Nutzen-Checks + CTAs, rechts das echte Portrait der Inhaberin
 * in einem Rahmen mit feinen Gold-Linien und einer schwebenden Geraete-Karte.
 * Bewusst weiss-dominant (Kontrast zur dunklen Wortmarke/den dunklen Sektionen).
 */
const checks = [
  'Zertifizierte Laserschutzbeauftragte',
  'Gekühlter 808 nm Diodenlaser, schmerzarm',
  'Kostenlose, ehrliche Erstberatung',
  'Mitten in Gelsenkirchen Buer',
];
---
<section id="hero" class="hero" data-hero>
  <div class="hero__aura" aria-hidden="true"></div>

  <div class="container-page hero__inner">
    <!-- Text -->
    <div class="hero__content">
      <p class="hero__eyebrow" data-hero-el>
        <span class="hero__eyebrow-line"></span>
        Dauerhafte Laser Haarentfernung
      </p>

      <h1 class="hero__title">
        <span class="hero__line" data-hero-line>Dauerhaft glatte Haut.</span>
        <span class="hero__line text-gold" data-hero-line>Ganz ohne Rasieren.</span>
      </h1>

      <p class="hero__lead" data-hero-el>
        Mit dem gekühlten VIKINI&nbsp;Diodenlaser reduzieren wir deine Haare dauerhaft und
        schmerzarm – begleitet von einer zertifizierten Laserschutzbeauftragten.
      </p>

      <ul class="hero__checks" data-hero-el>
        {checks.map((c) => (
          <li class="hero__check">
            <span class="hero__check-ic"><Icon name="check" class="w-3.5 h-3.5" /></span>
            <span>{c}</span>
          </li>
        ))}
      </ul>

      <div class="hero__actions" data-hero-el>
        <a href="#kontakt" class="btn btn-primary" data-track="cta_hero">Kostenlose Beratung anfragen</a>
        <a href="#preise" class="hero__secondary" data-track="cta_hero_preise">
          <Icon name="euro" class="w-5 h-5" /> Preise ansehen
        </a>
      </div>

      <a class="hero__trust" href={site.googleReviewUrl} target="_blank" rel="noopener" data-track="google_reviews" data-hero-el>
        <span class="hero__trust-g" aria-hidden="true">
          <svg viewBox="0 0 48 48" width="20" height="20">
            <path fill="#4285F4" d="M43.6 20.1H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.9z"/>
            <path fill="#34A853" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
            <path fill="#FBBC05" d="M12.7 28.1c-.4-1.3-.7-2.7-.7-4.1s.3-2.8.7-4.1l-6.5-5C4.8 17.6 4 20.7 4 24s.8 6.4 2.2 9.1l6.5-5z"/>
            <path fill="#EA4335" d="M24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.2 4 9.5 8.4 6.2 14.9l6.5 5C14.4 15.3 18.8 12 24 12z"/>
          </svg>
        </span>
        <span class="hero__trust-stars" role="img" aria-label="Top bewertet auf Google">
          {Array.from({ length: 5 }).map(() => <Icon name="star" class="w-4 h-4" />)}
        </span>
        <span class="hero__trust-label">Bewertungen auf Google</span>
        <Icon name="arrow-up-right" class="w-3.5 h-3.5 hero__trust-go" />
      </a>
    </div>

    <!-- Visual -->
    <div class="hero__visual" data-hero-el>
      <div class="hero__frame">
        <span class="hero__ln hero__ln--v" aria-hidden="true"></span>
        <span class="hero__ln hero__ln--h" aria-hidden="true"></span>
        <div class="hero__img-wrap">
          <Image
            src={heroImg}
            alt="Maria Espejo, Inhaberin von Belium Beauty in Gelsenkirchen Buer"
            widths={[560, 780, 1040]}
            sizes="(min-width: 1024px) 42vw, 90vw"
            loading="eager"
            fetchpriority="high"
            format="avif"
            quality={66}
            class="hero__img"
            data-parallax="6"
          />
        </div>

        <!-- schwebende Geraete-Karte -->
        <div class="hero__stat">
          <span class="hero__stat-num">808<span>nm</span></span>
          <span class="hero__stat-label">VIKINI Diodenlaser</span>
          <span class="hero__stat-note"><Icon name="snowflake" class="w-4 h-4" /> Saphir-gekühlt &amp; schmerzarm</span>
        </div>

        <!-- kleines Vertrauens-Badge -->
        <div class="hero__chip">
          <Icon name="award" class="w-4 h-4" />
          <span>Zertifizierte<br />Laserschutz&shy;beauftragte</span>
        </div>
      </div>
    </div>
  </div>

  <a href="#einstieg" class="hero__scroll" aria-label="Weiterscrollen" data-hero-el>
    <span>Entdecken</span>
    <Icon name="arrow-down" class="w-4 h-4" />
  </a>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-cream);
    padding-top: clamp(6.5rem, 13vh, 9rem);
    padding-bottom: clamp(3rem, 7vh, 5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__aura {
    position: absolute; z-index: -1; pointer-events: none;
    top: -18%; right: -8%; width: 44rem; height: 44rem; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-gold) 22%, transparent) 0%, transparent 62%);
    filter: blur(6px);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    align-items: center;
    min-height: min(84svh, 720px);
  }
  @media (min-width: 1000px) {
    .hero__inner { grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 3vw, 3rem); }
  }

  /* ---- Text ---- */
  .hero__eyebrow {
    display: inline-flex; align-items: center; gap: 0.7rem;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-gold-deep); margin-bottom: 1.3rem;
  }
  .hero__eyebrow-line { width: 2.2rem; height: 2px; border-radius: 2px; background: var(--gradient-gold); }

  .hero__title {
    font-size: clamp(2.7rem, 6.4vw, 4.6rem);
    line-height: 1.03; letter-spacing: -0.02em; color: var(--color-ink);
    overflow: hidden;
  }
  .hero__line { display: block; }

  .hero__lead {
    margin-top: 1.4rem; max-width: 40ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem); color: var(--color-ink-soft); line-height: 1.6;
  }

  .hero__checks { list-style: none; margin-top: 1.6rem; display: grid; gap: 0.7rem; }
  @media (min-width: 560px) { .hero__checks { grid-template-columns: 1fr 1fr; } }
  .hero__check { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; font-size: 0.94rem; color: var(--color-espresso); }
  .hero__check-ic {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 1.5rem; height: 1.5rem; border-radius: 50%; color: #fff;
    background: var(--gradient-gold); box-shadow: var(--shadow-gold);
  }

  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem 1.4rem; margin-top: 2rem; }
  /* Sekundäre Aktion bewusst als zurückhaltender Textlink – kein zweiter Hauptbutton. */
  .hero__secondary {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-weight: 700; font-size: 0.95rem; color: var(--color-espresso); text-decoration: none;
    padding: 0.4rem 0.2rem; border-bottom: 1.5px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .hero__secondary :global(svg) { color: var(--color-gold-deep); }
  .hero__secondary:hover { color: var(--color-gold-deep); border-color: var(--color-gold); }

  /* Google-Bewertungen – Trust-Element, verlinkt aufs Google-Unternehmensprofil */
  .hero__trust {
    display: inline-flex; align-items: center; gap: 0.55rem; margin-top: 1.5rem;
    width: max-content; max-width: 100%; text-decoration: none; color: var(--color-espresso);
    padding: 0.5rem 0.9rem; border: 1px solid var(--color-sand-deep); border-radius: var(--radius-sm);
    background: color-mix(in srgb, #fff 72%, transparent); backdrop-filter: blur(4px);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero__trust:hover { border-color: var(--color-gold); transform: translateY(-1px); box-shadow: var(--shadow-soft); }
  .hero__trust-g { flex: 0 0 auto; display: inline-flex; }
  .hero__trust-stars { display: inline-flex; gap: 0.08rem; color: var(--color-gold); }
  .hero__trust-label { font-size: 0.86rem; font-weight: 700; }
  .hero__trust :global(.hero__trust-go) { color: var(--color-mocha); flex: 0 0 auto; }

  /* ---- Visual ---- */
  .hero__visual { position: relative; }
  .hero__frame { position: relative; max-width: 30rem; margin-inline: auto; }
  @media (min-width: 1000px) { .hero__frame { margin-right: 0; } }

  .hero__img-wrap {
    position: relative; overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-float);
    border: 1px solid var(--color-sand);
    background: var(--color-cream-deep);
    z-index: 1;
  }
  .hero__img { width: 100%; height: 116%; object-fit: cover; object-position: center 22%; }

  /* feine Gold-Geometrie hinter dem Bild */
  .hero__ln { position: absolute; background: color-mix(in srgb, var(--color-gold) 55%, transparent); z-index: 0; }
  .hero__ln--v { top: -1.4rem; bottom: 2.5rem; left: -1.4rem; width: 1px; }
  .hero__ln--h { left: -1.4rem; right: 3rem; top: -1.4rem; height: 1px; }

  .hero__stat {
    position: absolute; z-index: 2; left: -1.1rem; bottom: 1.6rem;
    background: color-mix(in srgb, var(--color-ink) 88%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--color-gold) 34%, transparent);
    border-radius: var(--radius-md); padding: 1rem 1.15rem;
    box-shadow: var(--shadow-float); min-width: 12.5rem;
  }
  .hero__stat-num {
    display: block; font-family: var(--font-display); font-weight: 700; line-height: 1;
    font-size: 2.4rem; color: var(--color-gold-light);
  }
  .hero__stat-num span { font-size: 1rem; margin-left: 0.15rem; }
  .hero__stat-label { display: block; margin-top: 0.15rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-onink-soft); }
  .hero__stat-note {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.8rem;
    font-weight: 600; font-size: 0.82rem; color: var(--color-gold-light);
  }

  .hero__chip {
    position: absolute; z-index: 2; right: -0.8rem; top: 1.4rem;
    display: flex; align-items: center; gap: 0.5rem;
    background: color-mix(in srgb, #fff 92%, transparent); backdrop-filter: blur(6px);
    border: 1px solid var(--color-sand-deep); border-radius: var(--radius-sm);
    padding: 0.5rem 0.85rem 0.5rem 0.6rem; box-shadow: var(--shadow-card);
    font-size: 0.7rem; font-weight: 700; line-height: 1.15; color: var(--color-espresso);
  }
  .hero__chip :global(svg) {
    flex: 0 0 auto; color: #fff; width: 1.5rem; height: 1.5rem; padding: 0.32rem;
    border-radius: 50%; background: var(--gradient-gold);
  }

  .hero__scroll {
    display: none;
    margin: clamp(2rem, 4vw, 3rem) auto 0; width: max-content;
    flex-direction: column; align-items: center; gap: 0.35rem;
    font-size: 0.66rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--color-mocha); text-decoration: none;
  }
  .hero__scroll :global(svg) { color: var(--color-gold-deep); animation: hero-bounce 1.8s ease-in-out infinite; }
  @keyframes hero-bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(5px); } }
  @media (min-width: 1000px) { .hero__scroll { display: flex; } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll :global(svg) { animation: none; } }
</style>
