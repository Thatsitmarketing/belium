---
/**
 * Standort & Kontakt – abgedunkeltes Studio-Foto als Hintergrund, links die Kontaktwege,
 * rechts eine schwebende weisse Formular-Karte (Ref-Stil). Karte (Google Maps) darunter,
 * erst nach Einwilligung.
 */
import { Image } from 'astro:assets';
import { site, telLink } from '@/data/site';
import LeadForm from '@/components/LeadForm.astro';
import Icon from '@/components/Icon.astro';
import bgImg from '@/assets/images/behandlungsraum-diodenlaser-belium-gelsenkirchen-buer.jpg';

const mapEmbed = `https://www.google.com/maps?q=${site.address.mapsQuery}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${site.address.mapsQuery}`;
---
<section id="kontakt" class="kontakt">
  <div class="kontakt__bg" aria-hidden="true">
    <Image src={bgImg} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" format="avif" quality={58} class="kontakt__bg-img" />
    <div class="kontakt__bg-scrim"></div>
  </div>

  <div class="container-page kontakt__inner">
    <!-- Intro / Kontaktwege (auf dunklem Foto) -->
    <div class="kontakt__intro" data-reveal="right">
      <p class="t-eyebrow t-eyebrow--on-dark">Standort &amp; Kontakt</p>
      <h2 class="kontakt__title">Kostenlose <span class="text-gold--on-dark">Beratung anfragen</span></h2>
      <p class="kontakt__lead">
        Unverbindlich und ehrlich, mitten in Gelsenkirchen&nbsp;Buer. Ruf uns an oder sende deine Anfrage.
        Wir melden uns zeitnah und finden gemeinsam einen Termin.
      </p>

      <div class="kontakt__channels">
        <a href={telLink()} class="kchannel" data-track="telefon_klick">
          <span class="kchannel__ic"><Icon name="phone" class="w-5 h-5" /></span>
          <span class="kchannel__body"><span class="kchannel__label">Anrufen</span><span class="kchannel__val">{site.contact.phone}</span></span>
          <Icon name="arrow-up-right" class="w-4 h-4 kchannel__go" />
        </a>
        <a href={`mailto:${site.contact.email}`} class="kchannel">
          <span class="kchannel__ic"><Icon name="mail" class="w-5 h-5" /></span>
          <span class="kchannel__body"><span class="kchannel__label">E-Mail</span><span class="kchannel__val">{site.contact.email}</span></span>
          <Icon name="arrow-up-right" class="w-4 h-4 kchannel__go" />
        </a>
      </div>

      <div class="kontakt__meta">
        <div class="kmeta">
          <span class="kmeta__h"><Icon name="map-pin" class="w-4 h-4" /> Adresse</span>
          <address class="kmeta__addr">{site.address.street}<br />{site.address.zip} {site.address.city} {site.address.district}</address>
        </div>
        <div class="kmeta">
          <span class="kmeta__h"><Icon name="clock" class="w-4 h-4" /> Öffnungszeiten</span>
          <p class="kmeta__hours">Termine nach Vereinbarung.<br />Ruf uns an, wir finden einen Slot.</p>
        </div>
      </div>
    </div>

    <!-- Formular-Karte -->
    <div class="kontakt__card" data-reveal="left">
      <h3 class="kontakt__card-title">Anfrage senden</h3>
      <p class="kontakt__card-sub">Unverbindlich. Wir melden uns zeitnah bei dir zurück.</p>
      <LeadForm id="leadform-kontakt" />
    </div>
  </div>

  <!-- Karte: erst nach Einwilligung -->
  <div class="container-page">
    <div class="kontakt__map" data-map data-reveal="up">
      <div class="kontakt__map-gate" data-map-gate>
        <Icon name="map" class="w-8 h-8" />
        <p>Die Google-Karte wird erst nach deiner Einwilligung geladen.</p>
        <div class="kontakt__map-actions">
          <button type="button" class="btn btn-ghost" data-map-load>Karte laden</button>
          <a href={mapLink} target="_blank" rel="noopener" class="btn btn-ghost">In Google Maps öffnen</a>
        </div>
      </div>
      <div class="kontakt__map-frame" data-map-frame hidden data-embed={mapEmbed}></div>
    </div>
  </div>
</section>

<style>
  /* Zusätzlicher Fußabstand, damit der überlappend hochgezogene Footer nur den freien
     Bereich abdeckt und keine Inhalte (Karte) verdeckt. */
  .kontakt { position: relative; overflow: hidden; padding-top: clamp(4rem, 8vw, 7.5rem); padding-bottom: clamp(6rem, 10vw, 9.5rem); color: var(--color-onink); isolation: isolate; }
  .kontakt__bg { position: absolute; inset: 0; z-index: -1; }
  .kontakt__bg-img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .kontakt__bg-scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(70% 60% at 20% 25%, rgba(230,178,90,0.14) 0%, transparent 60%),
      linear-gradient(105deg, rgba(12,9,6,0.94) 0%, rgba(15,11,8,0.86) 45%, rgba(18,13,9,0.66) 100%);
  }

  .kontakt__inner { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 4vw, 3rem); align-items: center; }
  @media (min-width: 960px) { .kontakt__inner { grid-template-columns: 1fr 1fr; } }

  /* Intro */
  .kontakt__title { color: #fff; font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; margin-top: 0.6rem; }
  .kontakt__lead { margin-top: 0.9rem; color: var(--color-onink); max-width: 42ch; font-size: 1.05rem; }

  .kontakt__channels { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1.8rem; max-width: 26rem; }
  .kchannel {
    display: flex; align-items: center; gap: 0.85rem; text-decoration: none;
    padding: 0.85rem 1rem; border-radius: var(--radius-sm);
    background: color-mix(in srgb, #fff 8%, transparent);
    border: 1px solid color-mix(in srgb, #fff 14%, transparent);
    backdrop-filter: blur(6px);
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
  }
  .kchannel:hover { border-color: color-mix(in srgb, var(--color-gold) 55%, transparent); transform: translateX(3px); }
  .kchannel__ic {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%; color: var(--color-gold-light);
    background: color-mix(in srgb, var(--color-gold) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-gold) 32%, transparent);
  }
  .kchannel__body { flex: 1 1 auto; display: flex; flex-direction: column; line-height: 1.25; }
  .kchannel__label { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-light); }
  .kchannel__val { font-weight: 700; color: #fff; font-size: 0.98rem; }
  .kchannel__go { color: var(--color-onink-soft); flex: 0 0 auto; }

  .kontakt__meta { display: grid; grid-template-columns: 1fr; gap: 1.1rem; margin-top: 1.6rem; }
  @media (min-width: 480px) { .kontakt__meta { grid-template-columns: 1fr 1fr; } }
  .kmeta__h { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-gold-light); margin-bottom: 0.4rem; }
  .kmeta__addr { font-style: normal; font-size: 0.95rem; line-height: 1.55; color: var(--color-onink); }
  .kmeta__hours { font-size: 0.92rem; color: var(--color-onink-soft); }

  /* Formular-Karte */
  .kontakt__card {
    background: color-mix(in srgb, var(--color-cream) 97%, #fff);
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-lg); padding: clamp(1.5rem, 3.5vw, 2.4rem);
    box-shadow: var(--shadow-float); color: var(--color-ink);
  }
  .kontakt__card-title { font-family: var(--font-display); font-weight: 600; font-size: 1.6rem; }
  .kontakt__card-sub { color: var(--color-mocha); font-size: 0.95rem; margin-top: 0.2rem; margin-bottom: 1.3rem; }
  /* Nach erfolgreichem Versand übernimmt das Danke-Fenster die Karte allein. */
  .kontakt__card.has-lead-success .kontakt__card-title,
  .kontakt__card.has-lead-success .kontakt__card-sub { display: none; }

  /* Karte */
  .kontakt__map { margin-top: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid color-mix(in srgb, #fff 16%, transparent); border-radius: var(--radius-lg); overflow: hidden; background: color-mix(in srgb, var(--color-ink) 60%, transparent); backdrop-filter: blur(6px); }
  .kontakt__map-gate {
    min-height: 240px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.9rem; text-align: center; padding: 1.5rem;
  }
  .kontakt__map-gate :global(svg) { color: var(--color-gold-light); }
  .kontakt__map-gate p { color: var(--color-onink); font-size: 0.9rem; max-width: 34ch; }
  .kontakt__map-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }
  .kontakt__map-frame { min-height: 240px; }
  .kontakt__map-frame :global(iframe) { width: 100%; height: 340px; border: 0; display: block; }
</style>

<script>
  const map = document.querySelector<HTMLElement>('[data-map]');
  if (map) {
    const gate = map.querySelector<HTMLElement>('[data-map-gate]');
    const frameWrap = map.querySelector<HTMLElement>('[data-map-frame]');
    const loadBtn = map.querySelector<HTMLButtonElement>('[data-map-load]');
    const embed = frameWrap?.dataset.embed;

    function loadMap() {
      if (!frameWrap || !embed || frameWrap.dataset.loaded) return;
      const iframe = document.createElement('iframe');
      iframe.src = embed;
      iframe.loading = 'lazy';
      iframe.title = 'Standort von Belium Beauty auf Google Maps';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.setAttribute('allowfullscreen', '');
      frameWrap.appendChild(iframe);
      frameWrap.dataset.loaded = '1';
      frameWrap.hidden = false;
      if (gate) gate.hidden = true;
    }

    if ((window as any).__beliumConsent === 'all') loadMap();
    window.addEventListener('belium:consent', (e: any) => { if (e.detail?.granted) loadMap(); });
    loadBtn?.addEventListener('click', loadMap);
  }
</script>
