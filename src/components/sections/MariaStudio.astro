---
/**
 * Vertrauensabschnitt „Über Maria" + Studio.
 * Oben: Maria im ruhigen, parallelen Split (Bild neben Text, ohne Überlappung).
 * Unten: ein voll-breiter, durchlaufender Studio-Bilderslider – er dient zugleich als
 * Trenner zwischen diesem und dem nächsten Abschnitt (nur Bilder, keine Bullet-Points).
 */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import mariaImg from '@/assets/images/maria-espejo-belium-beauty-gelsenkirchen.jpg';
import behandlungsraum2 from '@/assets/images/behandlungsraum-diodenlaser-belium-gelsenkirchen-buer.jpg';
import lichtdecke from '@/assets/images/behandlungsraum-lichtdecke-belium-gelsenkirchen-buer.jpg';
import eingang from '@/assets/images/studio-eingang-belium-gelsenkirchen-buer.jpg';
import wartebereich from '@/assets/images/wartebereich-blumen-belium-gelsenkirchen-buer.jpg';
import empfang from '@/assets/images/studio-empfang-flyer-belium-gelsenkirchen-buer.jpg';
import wandbild from '@/assets/images/studio-wandbild-belium-gelsenkirchen-buer.jpg';
import spiegel from '@/assets/images/studio-spiegel-detail-belium-gelsenkirchen-buer.jpg';
import liege from '@/assets/images/behandlungsliege-laserschutzbrille-belium-gelsenkirchen.jpg';

const qualifikationen = [
  'Zertifizierte Laserschutzbeauftragte für kosmetische Laserbehandlungen',
  'NiSV-zertifiziert nach der Verordnung zum Schutz vor nichtionisierender Strahlung',
  'Schwerpunkte Lasersicherheit und Laserschutz (BGV B2, DIN VDE 56912, EN 60825)',
  'Ausbildung bei Belium Medical in Spanien',
  'Laufende Weiterbildungen im Bereich Dermatologie',
];

const studio = [
  { src: eingang, alt: 'Einladender Eingangsbereich mit beleuchteter Treppe im Studio von Belium Beauty' },
  { src: lichtdecke, alt: 'Beleuchtete Lichtdecke sorgt für Wohlfühlatmosphäre im Behandlungsraum' },
  { src: wartebereich, alt: 'Wartebereich mit frischen Blumen im Studio von Belium Beauty' },
  { src: behandlungsraum2, alt: 'Behandlungsraum mit Diodenlaser bei Belium Beauty in Gelsenkirchen Buer' },
  { src: liege, alt: 'Frisch bezogene Behandlungsliege mit bereitgelegter Laserschutzbrille' },
  { src: wandbild, alt: 'Beleuchtetes Wandbild und Trockenblumen im Studio von Belium Beauty' },
  { src: empfang, alt: 'Infoflyer und Visitenkarten von Belium Beauty am Empfang' },
  { src: spiegel, alt: 'Dekorativer Sonnenspiegel mit Spiegelung des Wandbildes im Studio' },
];
---
<section id="ueber-maria" class="maria">
  <div class="container-page maria__intro">
    <header class="section-head reveal">
      <p class="t-eyebrow">Persönlich behandelt</p>
      <h2 class="t-h2">Persönlich behandelt. <span class="text-gold">Professionell begleitet.</span></h2>
      <p class="t-lead section-head__lead">
        Bei Belium Beauty behandelt dich Maria persönlich, NiSV-zertifiziert, mit geprüfter
        Lasersicherheit und einem ruhigen, ehrlichen Umgang.
      </p>
    </header>

    <div class="maria__grid">
      <div class="maria__media reveal">
        <Image
          src={mariaImg}
          alt="Maria Espejo Jimenez, Inhaberin von Belium Beauty und zertifizierte Laserschutzbeauftragte in Gelsenkirchen Buer"
          widths={[380, 560, 760]}
          sizes="(min-width: 900px) 40vw, 88vw"
          loading="lazy"
          format="avif"
          quality={72}
          class="maria__img"
        />
        <div class="maria__badges">
          <span class="maria__badge"><Icon name="award" class="w-4 h-4" /> Zertifizierte Laserschutzbeauftragte</span>
          <span class="maria__badge"><Icon name="shield" class="w-4 h-4" /> NiSV-zertifiziert</span>
        </div>
      </div>

      <div class="maria__content reveal">
        <p class="maria__name">{site.ownerShort}</p>
        <p class="maria__lead">
          Du bekommst eine klare Einschätzung, was für dich sinnvoll ist und was nicht. Statt
          Verkaufsdruck steht die richtige Entscheidung für deine Haut im Mittelpunkt.
        </p>
        <ul class="maria__quali">
          {qualifikationen.map((q) => (
            <li><Icon name="check-circle" class="w-5 h-5" /><span>{q}</span></li>
          ))}
        </ul>

        <div class="section-cta">
          <a href="#kontakt" class="btn btn-primary" data-track="cta_maria">Termin bei Maria anfragen</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Voll-breiter, durchlaufender Studio-Slider, zugleich Trenner zum nächsten Abschnitt -->
  <div class="mslider" data-mslider aria-label="Eindrücke aus dem Studio">
    <div class="mslider__track">
      {[0, 1].map((copy) => (
        <div class="mslider__group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {studio.map((b) => (
            <figure class="mslider__item">
              <Image
                src={b.src}
                alt={copy === 1 ? '' : b.alt}
                widths={[360, 520, 680]}
                sizes="(min-width: 900px) 24vw, 70vw"
                loading="lazy"
                format="avif"
                quality={62}
                class="mslider__img"
              />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .maria { background: var(--color-cream); padding-top: clamp(3.75rem, 8vw, 7.5rem); }

  /* --- Intro: Bild neben Text, ruhig & parallel (keine Überlappung) --- */
  .maria__grid { display: grid; grid-template-columns: 1fr; gap: 2.25rem; align-items: center; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  @media (min-width: 900px) { .maria__grid { grid-template-columns: 0.62fr 1.38fr; gap: clamp(2.5rem, 5vw, 4rem); } }

  /* Bild bewusst kompakt gehalten, damit es neben dem Text nicht zu groß wirkt. */
  .maria__media { position: relative; max-width: 22rem; }
  @media (min-width: 900px) { .maria__media { max-width: 100%; } }
  .maria__img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: top center; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  /* Zwei Nachweise übereinander statt eines einzelnen Badges: der Block wird positioniert,
     die Badges selbst bleiben im Fluss und schrumpfen auf ihre Textbreite. */
  .maria__badges {
    position: absolute; left: 0.9rem; bottom: 0.9rem; right: 0.9rem;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem;
  }
  .maria__badge {
    display: inline-flex; align-items: flex-start; gap: 0.45rem; max-width: 100%;
    background: color-mix(in srgb, var(--color-ink) 88%, transparent); backdrop-filter: blur(6px);
    border: 1px solid color-mix(in srgb, var(--color-gold) 34%, transparent);
    color: var(--color-gold-light); border-radius: var(--radius-sm);
    padding: 0.5rem 0.9rem; font-size: 0.78rem; font-weight: 700; box-shadow: var(--shadow-card);
  }

  .maria__name { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.7rem, 3vw, 2.2rem); color: var(--color-ink); }
  .maria__lead { margin-top: 0.8rem; color: var(--color-ink-soft); font-size: 1.05rem; line-height: 1.6; }
  .maria__quali { list-style: none; margin-top: 1.4rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .maria__quali li { display: flex; align-items: flex-start; gap: 0.6rem; font-weight: 600; }
  .maria__quali :global(svg) { color: var(--color-gold-deep); flex: 0 0 auto; margin-top: 0.1rem; }

  /* --- Voll-breiter Studio-Slider (Trenner): randlos, ohne Abstände, große Bilder --- */
  .mslider {
    position: relative; overflow: hidden; width: 100%;
    background: var(--color-cream);
  }
  .mslider__track { display: flex; width: max-content; }
  .mslider__group {
    display: flex; flex: 0 0 auto; gap: 0; padding: 0;
    animation: mslider-run 85s linear infinite;
  }
  .mslider:hover .mslider__group { animation-play-state: paused; }
  @keyframes mslider-run {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mslider { overflow-x: auto; scrollbar-width: none; }
    .mslider::-webkit-scrollbar { display: none; }
    .mslider__group { animation: none; }
    .mslider__group[aria-hidden="true"] { display: none; }
  }

  .mslider__item { flex: 0 0 auto; margin: 0; }
  .mslider__img {
    display: block; width: clamp(15rem, 30vw, 30rem); height: clamp(11rem, 22vw, 19rem);
    object-fit: cover; border-radius: 0;
  }
</style>
