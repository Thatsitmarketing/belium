---
/** Abschnitt 9: Räumlichkeiten. Bildergalerie mit Lightbox, lazy loading. */
import { Image } from 'astro:assets';
import warteraum from '@/assets/images/warteraum-belium-gelsenkirchen-buer.png';
import wartebereich from '@/assets/images/wartebereich-belium-gelsenkirchen-buer.png';
import behandlungsraumNeutral from '@/assets/images/behandlungsraum-neutral-belium-gelsenkirchen-buer.png';
import deko from '@/assets/images/studio-dekoration-belium-gelsenkirchen-buer.png';
import lichtdecke from '@/assets/images/studio-lichtdecke-belium-gelsenkirchen-buer.png';
import zugang from '@/assets/images/studio-zugang-belium-gelsenkirchen-buer.png';

const bilder = [
  { src: warteraum, alt: 'Gemütlicher Wartebereich im Studio von Belium Beauty in Gelsenkirchen Buer' },
  { src: behandlungsraumNeutral, alt: 'Ruhiger, sauberer Behandlungsraum bei Belium Beauty' },
  { src: wartebereich, alt: 'Empfangs- und Wartebereich mit warmer Beleuchtung bei Belium Beauty' },
  { src: deko, alt: 'Liebevoll gestaltete Dekoration im Studio von Belium Beauty' },
  { src: lichtdecke, alt: 'Beleuchtete Lichtdecke sorgt für Wohlfühlatmosphäre im Behandlungsraum' },
  { src: zugang, alt: 'Heller, einladender Zugang zum Studio von Belium Beauty in Buer' },
];
---
<section id="raeumlichkeiten" class="section-pad raeume">
  <div class="container-page">
    <header class="section-head reveal">
      <p class="t-eyebrow">Räumlichkeiten</p>
      <h2 class="t-h2">Ein Ort zum Wohlfühlen</h2>
      <p class="t-lead section-head__lead">
        Hygiene, Diskretion und eine ruhige Atmosphäre. So sieht es bei uns in Gelsenkirchen Buer aus.
      </p>
    </header>

    <div class="raeume__grid reveal" data-gallery>
      {bilder.map((b, i) => (
        <button type="button" class="raeume__item" data-index={i} aria-label={`Bild vergrößern: ${b.alt}`}>
          <Image
            src={b.src}
            alt={b.alt}
            widths={[360, 560, 760]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
            loading="lazy"
            format="avif"
            quality={66}
            class="raeume__img"
          />
        </button>
      ))}
    </div>
  </div>

  <!-- Lightbox -->
  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Bildergalerie">
    <button type="button" class="lightbox__close" data-lb-close aria-label="Schließen">&times;</button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Vorheriges Bild">&#8249;</button>
    <figure class="lightbox__fig">
      <img class="lightbox__img" data-lb-img alt="" />
      <figcaption class="lightbox__cap" data-lb-cap></figcaption>
    </figure>
    <button type="button" class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Nächstes Bild">&#8250;</button>
  </div>
</section>

<style>
  .raeume { background: var(--color-cream); }
  .raeume__grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @media (min-width: 640px) { .raeume__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .raeume__grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; } }

  .raeume__item {
    padding: 0; border: 0; cursor: pointer; overflow: hidden; border-radius: var(--radius-md);
    background: var(--color-sand); box-shadow: var(--shadow-soft); position: relative;
  }
  .raeume__img { width: 100%; height: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .raeume__item:hover .raeume__img { transform: scale(1.05); }

  .lightbox {
    position: fixed; inset: 0; z-index: 120;
    background: color-mix(in srgb, var(--color-ink) 92%, #000);
    display: flex; align-items: center; justify-content: center; padding: 1.5rem;
  }
  .lightbox[hidden] { display: none; }
  .lightbox__fig { max-width: min(92vw, 1100px); max-height: 86vh; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin: 0; }
  .lightbox__img { max-width: 100%; max-height: 78vh; object-fit: contain; border-radius: var(--radius-md); box-shadow: var(--shadow-float); }
  .lightbox__cap { color: var(--color-cream); font-size: 0.9rem; text-align: center; max-width: 60ch; }
  .lightbox__close {
    position: absolute; top: 1rem; right: 1.25rem; z-index: 2;
    background: none; border: 0; color: #fff; font-size: 2.5rem; line-height: 1; cursor: pointer;
  }
  .lightbox__nav {
    background: color-mix(in srgb, #fff 12%, transparent); border: 0; color: #fff; cursor: pointer;
    width: 3rem; height: 3rem; border-radius: 50%; font-size: 2rem; line-height: 1;
    display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto;
    position: absolute; top: 50%; transform: translateY(-50%);
  }
  .lightbox__nav:hover { background: color-mix(in srgb, #fff 22%, transparent); }
  .lightbox__nav--prev { left: 0.5rem; }
  .lightbox__nav--next { right: 0.5rem; }
  @media (min-width: 640px) { .lightbox__nav--prev { left: 1.5rem; } .lightbox__nav--next { right: 1.5rem; } }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const lb = document.querySelector<HTMLElement>('[data-lightbox]');
  if (gallery && lb) {
    const imgEl = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const capEl = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
    const items = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.raeume__item'));
    const slides = items.map((btn) => {
      const img = btn.querySelector('img')!;
      return { src: img.currentSrc || img.src, alt: img.alt };
    });
    let idx = 0;
    let lastFocused: HTMLElement | null = null;

    function show(i: number) {
      idx = (i + slides.length) % slides.length;
      // volles Bild laden: srcset des <picture> nutzt bereits die groesste Variante über currentSrc
      const img = items[idx].querySelector('img')!;
      imgEl.src = img.currentSrc || img.src;
      imgEl.alt = slides[idx].alt;
      capEl.textContent = slides[idx].alt;
    }
    function open(i: number) {
      lastFocused = document.activeElement as HTMLElement;
      show(i);
      lb!.hidden = false;
      document.body.style.overflow = 'hidden';
      (lb!.querySelector('[data-lb-close]') as HTMLElement)?.focus();
    }
    function close() {
      lb!.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    items.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    lb.querySelector('[data-lb-close]')?.addEventListener('click', close);
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(idx - 1));
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => show(idx + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb!.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
  }
</script>
