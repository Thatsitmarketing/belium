---
/** Abschnitt 8: Über Maria. Zentraler Vertrauensanker. */
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import mariaImg from '@/assets/images/maria-espejo-belium-beauty-gelsenkirchen.png';

const qualifikationen = [
  'Zertifizierte Laserschutzbeauftragte für kosmetische Laserbehandlungen',
  'Schwerpunkte Lasersicherheit und Laserschutz (BGV B2, DIN VDE 56912, EN 60825)',
  'Ausbildung bei Belium Medical in Spanien',
  'Laufende Weiterbildungen im Bereich Dermatologie',
];
---
<section id="ueber-maria" class="section-pad maria">
  <div class="container-page maria__grid">
    <div class="maria__media reveal">
      <Image
        src={mariaImg}
        alt="Maria Espejo Jimenez, Inhaberin von Belium Beauty und zertifizierte Laserschutzbeauftragte in Gelsenkirchen Buer"
        widths={[380, 560, 760]}
        sizes="(min-width: 900px) 38vw, 88vw"
        loading="lazy"
        format="avif"
        quality={72}
        class="maria__img"
      />
    </div>
    <div class="maria__content reveal">
      <p class="t-eyebrow">Deine Behandlerin</p>
      <h2 class="t-h2">Maria Espejo Jimenez</h2>
      <p class="t-lead maria__lead">
        Bei Belium Beauty behandelt dich Maria persönlich. Als zertifizierte Laserschutzbeauftragte
        verbindet sie geprüfte Lasersicherheit mit einem ruhigen, ehrlichen Umgang. Du bekommst eine
        klare Einschätzung, was für dich sinnvoll ist, und was nicht.
      </p>
      <ul class="maria__quali">
        {qualifikationen.map((q) => (
          <li><Icon name="check-circle" class="w-5 h-5" /><span>{q}</span></li>
        ))}
      </ul>
      <a href="#kontakt" class="btn btn-primary maria__cta" data-track="cta_maria">Termin bei Maria anfragen</a>
    </div>
  </div>
</section>

<style>
  .maria { background: var(--color-cream-deep); }
  .maria__grid { display: grid; grid-template-columns: 1fr; gap: 2.25rem; align-items: center; }
  @media (min-width: 900px) { .maria__grid { grid-template-columns: 0.85fr 1.15fr; gap: 3rem; } }
  .maria__img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: top center; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .maria__lead { margin-top: 1rem; }
  .maria__quali { list-style: none; margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .maria__quali li { display: flex; align-items: flex-start; gap: 0.6rem; font-weight: 600; }
  .maria__quali :global(svg) { color: var(--color-gold-deep); flex: 0 0 auto; margin-top: 0.1rem; }
  .maria__cta { margin-top: 1.75rem; }
</style>
