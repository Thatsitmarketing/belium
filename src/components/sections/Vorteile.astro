---
/** Abschnitt 3: Vorteile als Karten (H3). */
import { vorteile } from '@/data/vorteile';
import Icon from '@/components/Icon.astro';
---
<section id="vorteile" class="section-pad vorteile">
  <div class="container-page">
    <header class="section-head reveal">
      <p class="t-eyebrow">Deine Vorteile</p>
      <h2 class="t-h2">Warum Laser statt <span class="text-gold">immer wieder rasieren</span></h2>
      <p class="t-lead section-head__lead">
        Sechs Gründe, warum unsere Kundinnen und Kunden auf die dauerhafte Methode umsteigen.
      </p>
    </header>

    <div class="vorteile__grid">
      {vorteile.map((v, i) => (
        <article class="card vorteil reveal">
          <span class="vorteil__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="icon-badge vorteil__icon"><Icon name={v.icon} class="w-7 h-7" gradient /></div>
          <h3 class="t-h3 vorteil__titel">{v.titel}</h3>
          <p class="vorteil__text">{v.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .vorteile { background: var(--color-cream-deep); }

  .vorteile__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  @media (min-width: 620px) { .vorteile__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .vorteile__grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }

  .vorteil {
    position: relative; padding: 1.7rem 1.6rem; overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.22,1,0.36,1), box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .vorteil:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); border-color: var(--color-gold-soft); }
  .vorteil__index {
    position: absolute; top: 0.9rem; right: 1.1rem;
    font-family: var(--font-display); font-weight: 700; font-size: 2.6rem; line-height: 1;
    color: color-mix(in srgb, var(--color-gold-soft) 55%, transparent);
  }
  .vorteil__icon { margin-bottom: 1.1rem; }
  .vorteil__titel { font-size: 1.35rem; position: relative; }
  .vorteil__text { margin-top: 0.55rem; color: var(--color-ink-soft); font-size: 0.98rem; }
</style>
