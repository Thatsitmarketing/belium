---
/** Abschnitt: Vorteile – prominente Karten mit grossen Gold-Medaillons (H3). */
import { vorteile } from '@/data/vorteile';
import Icon from '@/components/Icon.astro';
---
<section id="vorteile" class="section-pad vorteile">
  <div class="container-page">
    <header class="section-head vorteile__head" data-reveal="up">
      <p class="t-eyebrow">Deine Vorteile</p>
      <h2 class="t-h2">Warum Laser statt <span class="text-gold">immer wieder rasieren</span></h2>
      <p class="t-lead section-head__lead">
        Sechs handfeste Gründe, warum unsere Kundinnen und Kunden auf die dauerhafte Methode umsteigen.
      </p>
    </header>

    <div class="vorteile__grid" data-reveal-stagger>
      {vorteile.map((v, i) => (
        <article class="vcard" data-reveal="up">
          <span class="vcard__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="vcard__medal"><Icon name={v.icon} class="w-7 h-7" /></span>
          <h3 class="vcard__title">{v.titel}</h3>
          <p class="vcard__text">{v.text}</p>
          <span class="vcard__edge" aria-hidden="true"></span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .vorteile { background: var(--color-cream-deep); }

  .vorteile__grid {
    display: grid; grid-template-columns: 1fr; gap: 1.15rem;
  }
  @media (min-width: 620px) { .vorteile__grid { grid-template-columns: 1fr 1fr; gap: 1.35rem; } }
  @media (min-width: 1000px) { .vorteile__grid { grid-template-columns: repeat(3, 1fr); gap: 1.6rem; } }

  .vcard {
    position: relative; overflow: hidden;
    background: #fff; border: 1px solid var(--color-sand);
    border-radius: var(--radius-lg); padding: 2rem 1.8rem 1.9rem;
    box-shadow: var(--shadow-soft);
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .vcard:hover { transform: translateY(-6px); box-shadow: var(--shadow-card); border-color: color-mix(in srgb, var(--color-gold) 40%, var(--color-sand)); }

  .vcard__num {
    position: absolute; top: 1.1rem; right: 1.4rem;
    font-family: var(--font-display); font-weight: 700; font-size: 3rem; line-height: 1;
    color: color-mix(in srgb, var(--color-gold-soft) 42%, transparent);
    transition: color 0.3s ease;
  }
  .vcard:hover .vcard__num { color: color-mix(in srgb, var(--color-gold) 30%, transparent); }

  .vcard__medal {
    position: relative; z-index: 1;
    display: inline-flex; align-items: center; justify-content: center;
    width: 3.9rem; height: 3.9rem; border-radius: 1.15rem; margin-bottom: 1.3rem;
    color: #fff; background: var(--gradient-gold);
    box-shadow: var(--shadow-gold);
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);
  }
  .vcard:hover .vcard__medal { transform: rotate(-6deg) scale(1.06); }

  .vcard__title { font-family: var(--font-display); font-weight: 600; font-size: 1.42rem; line-height: 1.15; color: var(--color-ink); }
  .vcard__text { margin-top: 0.6rem; color: var(--color-ink-soft); font-size: 0.97rem; }

  /* Gold-Kante unten, waechst beim Hover */
  .vcard__edge {
    position: absolute; left: 0; bottom: 0; height: 3px; width: 100%;
    background: var(--gradient-gold);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.22,1,0.36,1);
  }
  .vcard:hover .vcard__edge { transform: scaleX(1); }
</style>
