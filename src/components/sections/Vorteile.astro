---
/**
 * Abschnitt „Warum Belium" – drei starke Säulen statt vieler kleiner Karten.
 * Kein CTA. Reduziert bewusst Wiederholungen (zertifiziert/gekühlt/individuell)
 * auf jeweils einen klaren Punkt pro Säule.
 */
import Icon from '@/components/Icon.astro';
import Ornament from '@/components/Ornament.astro';

const saeulen = [
  {
    icon: 'shield',
    titel: 'Sicher behandelt',
    punkte: [
      'Qualifizierte Behandlung nach geltenden Laserschutz-Normen',
      'Individuelle Hautanalyse vor jeder Sitzung',
      'Testfleck, bevor es richtig losgeht',
      'Ehrliche, realistische Einschätzung',
    ],
  },
  {
    icon: 'snowflake',
    titel: 'Angenehm & hautschonend',
    punkte: [
      'Gekühlte Saphirspitze schützt die Haut im selben Moment',
      'Einstellungen individuell an Hauttyp und Zone angepasst',
      'Schmerzarm – für viele angenehmer als Waxing',
      'Meist direkt wieder alltagstauglich',
    ],
  },
  {
    icon: 'heart',
    titel: 'Ehrlich & persönlich',
    punkte: [
      'Transparente Beratung ohne Verkaufsdruck',
      'Nachvollziehbare, klare Preise',
      'Keine Behandlung, wenn sie nicht sinnvoll ist',
      'Persönliche Betreuung von Anfang bis Ende',
    ],
  },
];
---
<section id="vorteile" class="section-pad vorteile">
  <div class="container-page">
    <header class="section-head section-head--center reveal">
      <Ornament />
      <p class="t-eyebrow t-eyebrow--center">Warum Belium</p>
      <h2 class="t-h2">Drei Gründe, uns zu <span class="text-gold">vertrauen</span></h2>
      <p class="t-lead section-head__lead">
        Keine leeren Versprechen – sondern Sicherheit, eine angenehme Behandlung und eine ehrliche,
        persönliche Begleitung.
      </p>
    </header>

    <div class="vorteile__grid" data-reveal-stagger>
      {saeulen.map((s) => (
        <article class="scard" data-reveal="up">
          <span class="scard__medal"><Icon name={s.icon} class="w-7 h-7" /></span>
          <h3 class="scard__title">{s.titel}</h3>
          <ul class="scard__list">
            {s.punkte.map((p) => (
              <li><Icon name="check" class="w-4 h-4 scard__check" />{p}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .vorteile { background: var(--color-cream-deep); }

  /* Offene Spalten statt Karten – getrennt durch feine Gold-Haarlinien. */
  .vorteile__grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 700px) { .vorteile__grid { grid-template-columns: 1fr 1fr; column-gap: 2.75rem; } }
  @media (min-width: 1000px) { .vorteile__grid { grid-template-columns: repeat(3, 1fr); column-gap: 3.25rem; } }

  .scard {
    padding-top: 1.6rem;
    border-top: 2px solid color-mix(in srgb, var(--color-gold) 55%, transparent);
  }

  .scard__medal {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3.2rem; height: 3.2rem; border-radius: var(--radius-sm); margin-bottom: 1.1rem;
    color: #2a1c07; background: var(--gradient-gold); box-shadow: var(--shadow-gold);
  }
  .scard__title { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; color: var(--color-ink); }
  .scard__list { list-style: none; margin-top: 1.1rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .scard__list li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.96rem; color: var(--color-ink-soft); }
  .scard__list :global(.scard__check) { flex: 0 0 auto; margin-top: 0.15rem; color: var(--color-gold-deep); }
</style>
