---
/**
 * Abschnitt: Zonen & Preise als geführter Funnel.
 * Schritt 1 Bereich (Damen/Herren) → Schritt 2 Zonen wählen (Live-Summe) →
 * Schritt 3 Paket oder Einzelsitzung → Schritt 4 Ergebnis + persönliches Angebot.
 * Ein Fortschrittsbalken zeigt den Stand; die Schritte erscheinen nacheinander.
 */
import { zonenGruppen, formatEuro, paketSitzungen, preisePlatzhalter } from '@/data/zonen';
import LeadForm from '@/components/LeadForm.astro';
import Icon from '@/components/Icon.astro';

const steps = [
  { n: 1, label: 'Bereich' },
  { n: 2, label: 'Zonen' },
  { n: 3, label: 'Paket' },
  { n: 4, label: 'Angebot' },
];
---
<section id="preise" class="section-pad preise">
  <div class="container-page">
    <header class="section-head section-head--center reveal">
      <p class="t-eyebrow t-eyebrow--center">Zonen &amp; Preise</p>
      <h2 class="t-h2">Berechne deinen Preis in <span class="text-gold">wenigen Schritten</span></h2>
      <p class="t-lead section-head__lead">
        Klick dich durch den Rechner. Du bekommst sofort eine unverbindliche Richtsumme –
        und auf Wunsch dein persönliches Angebot für die kostenlose Beratung.
      </p>
    </header>

    <div class="funnel reveal" data-funnel>
      <!-- Fortschrittsbalken -->
      <div class="funnel__progress" aria-hidden="true">
        <div class="funnel__track"><span class="funnel__bar" data-bar style="width: 12%"></span></div>
        <ol class="funnel__steps">
          {steps.map((s) => (
            <li class:list={['funnel__step', { 'is-active': s.n === 1 }]} data-step-dot={s.n}>
              <span class="funnel__step-num">{s.n}</span>
              <span class="funnel__step-label">{s.label}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="funnel__stage">
        <!-- SCHRITT 1: Bereich -->
        <div class="fstep" data-step="1">
          <p class="fstep__kicker"><span class="num-gold">01</span> Für wen ist die Behandlung?</p>
          <div class="choice-grid">
            {zonenGruppen.map((g) => (
              <button type="button" class="choice" data-gender={g.id}>
                <span class="choice__ic"><Icon name="user" class="w-6 h-6" gradient /></span>
                <span class="choice__name">{g.label}</span>
                <span class="choice__hint">{g.zonen.length} Zonen verfügbar</span>
                <span class="choice__go"><Icon name="arrow" class="w-4 h-4" /></span>
              </button>
            ))}
          </div>
        </div>

        <!-- SCHRITT 2: Zonen -->
        <div class="fstep" data-step="2" hidden>
          <p class="fstep__kicker"><span class="num-gold">02</span> Wähle deine Wunschzonen</p>
          {zonenGruppen.map((g, i) => (
            <div class="zones" data-zones={g.id} hidden={i !== 0}>
              {g.zonen.map((z) => (
                <button
                  type="button"
                  class="zone"
                  aria-pressed="false"
                  data-zone
                  data-name={z.name}
                  data-einzel={z.einzel}
                  data-paket={z.paket}
                >
                  <span class="zone__check"><Icon name="check" class="w-4 h-4" /></span>
                  <span class="zone__info">
                    <span class="zone__name">{z.name}</span>
                    {z.hinweis && <span class="zone__hinweis">{z.hinweis}</span>}
                  </span>
                  <span class="zone__preis">
                    <span class="zone__paket">{formatEuro(z.paket)}</span>
                    <span class="zone__einzel">einzeln {formatEuro(z.einzel)}</span>
                  </span>
                </button>
              ))}
            </div>
          ))}
        </div>

        <!-- SCHRITT 3: Paket oder Einzel -->
        <div class="fstep" data-step="3" hidden>
          <p class="fstep__kicker"><span class="num-gold">03</span> Wie möchtest du buchen?</p>
          <div class="choice-grid">
            <button type="button" class="choice choice--mode is-active" data-mode="paket">
              <span class="choice__badge">Empfohlen</span>
              <span class="choice__ic"><Icon name="gem" class="w-6 h-6" gradient /></span>
              <span class="choice__name">Paket</span>
              <span class="choice__hint">ca. {paketSitzungen} Sitzungen bis zum Ergebnis – bester Preis pro Sitzung.</span>
            </button>
            <button type="button" class="choice choice--mode" data-mode="einzel">
              <span class="choice__ic"><Icon name="droplet" class="w-6 h-6" gradient /></span>
              <span class="choice__name">Einzelsitzung</span>
              <span class="choice__hint">Erst einmal ausprobieren – Preis pro einzelner Sitzung.</span>
            </button>
          </div>
        </div>

        <!-- SCHRITT 4: Ergebnis -->
        <div class="fstep" data-step="4" hidden>
          <p class="fstep__kicker"><span class="num-gold">04</span> Deine unverbindliche Richtsumme</p>
          <div class="result">
            <div class="result__figure">
              <span class="result__mode" data-result-mode>Paketpreis</span>
              <span class="result__amount text-gold" data-result-amount>{formatEuro(0)}</span>
              <span class="result__meta" data-result-meta>für {paketSitzungen} Sitzungen</span>
              <span class="result__alt" data-result-alt></span>
            </div>
            <ul class="result__chips" data-result-chips aria-label="Gewählte Zonen"></ul>
          </div>

          {preisePlatzhalter && (
            <p class="preise__hinweis" role="note">
              <Icon name="info" class="w-5 h-5" />
              <span>Die angezeigten Preise sind Richtwerte zur Orientierung. Deinen verbindlichen
              Preis erhältst du im kostenlosen Beratungsgespräch.</span>
            </p>
          )}

          <div class="result__offer card" id="angebot">
            <h3 class="t-h3">Persönliches Angebot &amp; Wunschtermin</h3>
            <p class="result__offer-lead">
              Hinterlasse uns Name und Kontakt. Wir senden dir ein unverbindliches Angebot für deine
              Auswahl und schlagen einen Termin für die kostenlose Beratung vor.
            </p>
            <LeadForm id="leadform-angebot" variant="angebot" eventName="zonenwaehler_abschluss" />
          </div>
        </div>
      </div>

      <!-- Steuerung -->
      <div class="funnel__nav">
        <button type="button" class="funnel__back" data-back hidden>
          <Icon name="arrow" class="w-4 h-4 funnel__back-ic" /> Zurück
        </button>
        <div class="funnel__live" data-live hidden>
          <span class="funnel__live-count"><span data-count>0</span> Zonen</span>
          <span class="funnel__live-sep">·</span>
          <span class="funnel__live-sum text-gold" data-live-sum>{formatEuro(0)}</span>
        </div>
        <button type="button" class="btn btn-primary funnel__next" data-next disabled>
          Weiter <Icon name="arrow" class="w-4 h-4" />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .preise { background: var(--gradient-ink); color: var(--color-onink); position: relative; }
  .preise .t-h2 { color: #fff; }
  .preise .t-lead { color: var(--color-onink-soft); }

  .funnel {
    max-width: 60rem; margin-inline: auto;
    background: color-mix(in srgb, #fff 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-gold) 22%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
    overflow: hidden;
    backdrop-filter: blur(6px);
  }

  /* Fortschritt */
  .funnel__progress { padding: 1.4rem clamp(1.1rem, 4vw, 2.2rem) 0.4rem; }
  .funnel__track { height: 6px; border-radius: 999px; background: color-mix(in srgb, #fff 12%, transparent); overflow: hidden; }
  .funnel__bar { display: block; height: 100%; border-radius: 999px; background: var(--gradient-gold); transition: width 0.55s cubic-bezier(0.22,1,0.36,1); }
  .funnel__steps { list-style: none; display: flex; justify-content: space-between; margin-top: 0.9rem; }
  .funnel__step { display: flex; align-items: center; gap: 0.5rem; opacity: 0.5; transition: opacity 0.3s ease; }
  .funnel__step.is-active, .funnel__step.is-done { opacity: 1; }
  .funnel__step-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.7rem; height: 1.7rem; border-radius: 50%; font-size: 0.8rem; font-weight: 800;
    background: color-mix(in srgb, #fff 10%, transparent); color: var(--color-onink);
    border: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent);
    transition: background 0.3s ease, color 0.3s ease;
  }
  .funnel__step.is-active .funnel__step-num,
  .funnel__step.is-done .funnel__step-num { background: var(--gradient-gold); color: #2a1c07; border-color: transparent; }
  .funnel__step-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.02em; }
  @media (max-width: 520px) { .funnel__step-label { display: none; } }

  /* Stage */
  .funnel__stage { padding: clamp(1.2rem, 4vw, 2.2rem); }
  .fstep { animation: fstep-in 0.5s cubic-bezier(0.22,1,0.36,1); }
  .fstep[hidden] { display: none; }
  @keyframes fstep-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .fstep { animation: none; } }
  .fstep__kicker { font-size: 1.05rem; font-weight: 700; color: #fff; margin-bottom: 1.1rem; display: flex; align-items: baseline; gap: 0.6rem; }
  .fstep__kicker .num-gold { font-size: 1.5rem; }

  /* Auswahl-Karten (Bereich / Modus) */
  .choice-grid { display: grid; grid-template-columns: 1fr; gap: 0.9rem; }
  @media (min-width: 560px) { .choice-grid { grid-template-columns: 1fr 1fr; } }
  .choice {
    position: relative; text-align: left; cursor: pointer;
    display: flex; flex-direction: column; gap: 0.3rem;
    padding: 1.4rem 1.4rem; border-radius: var(--radius-md);
    background: color-mix(in srgb, #fff 6%, transparent);
    border: 1.5px solid color-mix(in srgb, #fff 14%, transparent);
    color: var(--color-onink);
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
  }
  .choice:hover { border-color: color-mix(in srgb, var(--color-gold) 60%, transparent); transform: translateY(-2px); }
  .choice.is-active { border-color: var(--color-gold); background: color-mix(in srgb, var(--color-gold) 12%, transparent); }
  .choice__ic {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem; border-radius: var(--radius-sm); margin-bottom: 0.5rem;
    background: color-mix(in srgb, var(--color-gold) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-gold) 32%, transparent);
  }
  .choice__name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: #fff; }
  .choice__hint { font-size: 0.88rem; color: var(--color-onink-soft); }
  .choice__go { position: absolute; top: 1.4rem; right: 1.4rem; color: var(--color-gold-light); opacity: 0; transition: opacity 0.2s ease, transform 0.2s ease; }
  .choice:hover .choice__go { opacity: 1; transform: translateX(3px); }
  .choice__badge {
    position: absolute; top: 1rem; right: 1rem;
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.25rem 0.6rem; border-radius: 999px; color: #2a1c07; background: var(--gradient-gold);
  }

  /* Zonen-Grid */
  .zones { display: grid; grid-template-columns: 1fr; gap: 0.6rem; }
  .zones[hidden] { display: none; }
  @media (min-width: 560px) { .zones { grid-template-columns: 1fr 1fr; } }
  .zone {
    display: flex; align-items: center; gap: 0.75rem; text-align: left; cursor: pointer;
    padding: 0.8rem 0.9rem; border-radius: var(--radius-sm);
    background: color-mix(in srgb, #fff 5%, transparent);
    border: 1.5px solid color-mix(in srgb, #fff 12%, transparent);
    color: var(--color-onink);
    transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.1s ease;
  }
  .zone:hover { border-color: color-mix(in srgb, var(--color-gold) 45%, transparent); }
  .zone:active { transform: scale(0.99); }
  .zone__check {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 1.5rem; height: 1.5rem; border-radius: 7px; color: transparent;
    border: 1.5px solid color-mix(in srgb, #fff 25%, transparent); transition: all 0.18s ease;
  }
  .zone__info { flex: 1 1 auto; display: flex; flex-direction: column; line-height: 1.2; }
  .zone__name { font-weight: 700; font-size: 0.98rem; color: #fff; }
  .zone__hinweis { font-size: 0.74rem; color: var(--color-onink-soft); }
  .zone__preis { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; line-height: 1.25; }
  .zone__paket { font-weight: 800; font-size: 0.95rem; color: var(--color-gold-light); }
  .zone__einzel { font-size: 0.72rem; color: var(--color-onink-soft); }
  .zone[aria-pressed='true'] { border-color: var(--color-gold); background: color-mix(in srgb, var(--color-gold) 14%, transparent); }
  .zone[aria-pressed='true'] .zone__check { background: var(--gradient-gold); border-color: transparent; color: #2a1c07; }

  /* Ergebnis */
  .result { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: center; margin-bottom: 1.5rem; }
  @media (min-width: 620px) { .result { grid-template-columns: auto 1fr; gap: 2rem; } }
  .result__figure {
    display: flex; flex-direction: column; align-items: flex-start;
    padding: 1.5rem 1.75rem; border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-gold) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent);
    min-width: 14rem;
  }
  .result__mode { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-gold-light); }
  .result__amount { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.6rem, 8vw, 3.6rem); line-height: 1; margin-top: 0.35rem; }
  .result__meta { font-size: 0.85rem; color: var(--color-onink-soft); margin-top: 0.35rem; }
  .result__alt { font-size: 0.85rem; color: var(--color-onink-soft); margin-top: 0.5rem; }
  .result__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; align-content: flex-start; }
  .result__chips li {
    display: inline-flex; align-items: center; gap: 0.35rem;
    background: color-mix(in srgb, #fff 8%, transparent); border: 1px solid color-mix(in srgb, #fff 16%, transparent);
    border-radius: 999px; padding: 0.32rem 0.75rem; font-size: 0.82rem; font-weight: 600; color: #fff;
  }

  .preise__hinweis {
    display: flex; align-items: flex-start; gap: 0.6rem;
    background: color-mix(in srgb, var(--color-gold) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-gold) 26%, transparent);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem; margin-bottom: 1.5rem; font-size: 0.9rem; color: var(--color-onink-soft);
  }
  .preise__hinweis :global(svg) { color: var(--color-gold-light); flex: 0 0 auto; margin-top: 0.1rem; }

  .result__offer { background: #fff; color: var(--color-ink); padding: clamp(1.25rem, 3vw, 2rem); }
  .result__offer-lead { margin: 0.6rem 0 1.25rem; color: var(--color-ink-soft); }

  /* Nav */
  .funnel__nav {
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem clamp(1.1rem, 4vw, 2.2rem) 1.4rem;
    border-top: 1px solid color-mix(in srgb, #fff 10%, transparent);
  }
  .funnel__back {
    display: inline-flex; align-items: center; gap: 0.4rem; background: none; border: 0; cursor: pointer;
    color: var(--color-onink-soft); font-weight: 700; font-size: 0.92rem;
  }
  .funnel__back:hover { color: #fff; }
  .funnel__back-ic { transform: rotate(180deg); }
  .funnel__live { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.95rem; color: #fff; }
  .funnel__live-sum { font-family: var(--font-display); font-size: 1.15rem; }
  .funnel__live-sep { color: var(--color-onink-soft); }
  .funnel__next { margin-left: auto; }
  .funnel__live + .funnel__next { margin-left: 1rem; }
  .funnel__next:disabled { opacity: 0.45; pointer-events: none; }
</style>

<script>
  import { formatEuro, paketSitzungen } from '@/data/zonen';
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-funnel]');
  if (root) {
    const bar = root.querySelector<HTMLElement>('[data-bar]');
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-step-dot]'));
    const fsteps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const backBtn = root.querySelector<HTMLButtonElement>('[data-back]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const liveBox = root.querySelector<HTMLElement>('[data-live]');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const liveSumEl = root.querySelector<HTMLElement>('[data-live-sum]');

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Ergebnis-Elemente
    const resAmount = root.querySelector<HTMLElement>('[data-result-amount]');
    const resMode = root.querySelector<HTMLElement>('[data-result-mode]');
    const resMeta = root.querySelector<HTMLElement>('[data-result-meta]');
    const resAlt = root.querySelector<HTMLElement>('[data-result-alt]');
    const resChips = root.querySelector<HTMLElement>('[data-result-chips]');

    // Lead-Formular
    const angebotForm = document.getElementById('leadform-angebot') as HTMLFormElement | null;
    const zonenField = angebotForm?.querySelector<HTMLInputElement>('input[name="zonen"]') ?? null;
    const summeField = angebotForm?.querySelector<HTMLInputElement>('input[name="summe"]') ?? null;
    const zonenSummary = angebotForm?.querySelector<HTMLElement>('[data-zonen-summary]') ?? null;
    const zonenText = angebotForm?.querySelector<HTMLElement>('[data-zonen-text]') ?? null;

    const state = {
      step: 1,
      gender: '' as '' | 'damen' | 'herren',
      mode: 'paket' as 'paket' | 'einzel',
      selected: new Map<string, { einzel: number; paket: number; btn: HTMLButtonElement }>(),
      started: false,
    };

    function totals() {
      let paket = 0, einzel = 0;
      state.selected.forEach((v) => { paket += v.paket; einzel += v.einzel; });
      return { paket, einzel };
    }

    function animateNumber(el: HTMLElement | null, to: number) {
      if (!el) return;
      if (prefersReduced) { el.textContent = formatEuro(to); return; }
      const from = Number(el.dataset.val || 0);
      const obj = { v: from };
      gsap.to(obj, {
        v: to, duration: 0.7, ease: 'power2.out',
        onUpdate: () => { el.textContent = formatEuro(Math.round(obj.v)); },
      });
      el.dataset.val = String(to);
    }

    function updateLive() {
      const { paket, einzel } = totals();
      const count = state.selected.size;
      if (countEl) countEl.textContent = String(count);
      if (liveSumEl) liveSumEl.textContent = formatEuro(state.mode === 'einzel' ? einzel : paket);
      if (nextBtn && state.step === 2) nextBtn.disabled = count === 0;
    }

    function syncForm() {
      const names = Array.from(state.selected.keys());
      const { paket, einzel } = totals();
      const summe = state.mode === 'einzel' ? einzel : paket;
      const modeLabel = state.mode === 'einzel' ? 'Einzelsitzung' : `Paket (ca. ${paketSitzungen} Sitzungen)`;
      if (zonenField) zonenField.value = names.join(', ');
      if (summeField) summeField.value = String(summe);
      if (zonenText) zonenText.textContent = names.length ? `${names.join(', ')} · ${modeLabel} ca. ${formatEuro(summe)}` : '—';
      if (zonenSummary) zonenSummary.hidden = names.length === 0;
    }

    function renderResult() {
      const { paket, einzel } = totals();
      const isPaket = state.mode === 'paket';
      animateNumber(resAmount, isPaket ? paket : einzel);
      if (resMode) resMode.textContent = isPaket ? 'Paketpreis' : 'Einzelsitzung';
      if (resMeta) resMeta.textContent = isPaket ? `für ca. ${paketSitzungen} Sitzungen` : 'pro Sitzung';
      if (resAlt) resAlt.textContent = isPaket
        ? `Einzelne Sitzung: ca. ${formatEuro(einzel)}`
        : `Als Paket (${paketSitzungen} Sitzungen): ca. ${formatEuro(paket)}`;
      if (resChips) {
        resChips.innerHTML = '';
        state.selected.forEach((_, name) => {
          const li = document.createElement('li');
          li.innerHTML = `<span>${name}</span>`;
          resChips.appendChild(li);
        });
      }
      syncForm();
    }

    // --- Schrittsteuerung ---
    function progressPercent(step: number) {
      // Balken fuellt sich ueber die 4 Schritte
      return [12, 40, 68, 100][step - 1] ?? 12;
    }

    function goTo(step: number) {
      state.step = step;
      fsteps.forEach((el) => { el.hidden = Number(el.dataset.step) !== step; });
      dots.forEach((d) => {
        const n = Number(d.dataset.stepDot);
        d.classList.toggle('is-active', n === step);
        d.classList.toggle('is-done', n < step);
      });
      if (bar) bar.style.width = progressPercent(step) + '%';

      // Nav-Zustand
      if (backBtn) backBtn.hidden = step === 1;
      if (liveBox) liveBox.hidden = !(step === 2 || step === 3);
      if (nextBtn) {
        if (step === 4) {
          nextBtn.hidden = true;
        } else {
          nextBtn.hidden = false;
          nextBtn.innerHTML = step === 3
            ? 'Ergebnis anzeigen <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>'
            : 'Weiter <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
          nextBtn.disabled = step === 2 ? state.selected.size === 0 : false;
        }
      }

      updateLive();
      if (step === 4) renderResult();

      // sanft in den Rechner scrollen (nicht beim ersten Laden)
      if (step > 1) {
        const top = root.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top, behavior: prefersReduced ? 'auto' : 'smooth' });
      }
    }

    // --- Schritt 1: Bereich ---
    root.querySelectorAll<HTMLButtonElement>('[data-gender]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.gender = btn.dataset.gender as 'damen' | 'herren';
        // relevante Zonengruppe zeigen
        root.querySelectorAll<HTMLElement>('[data-zones]').forEach((z) => {
          z.hidden = z.dataset.zones !== state.gender;
        });
        goTo(2);
      });
    });

    // --- Schritt 2: Zonen ---
    root.querySelectorAll<HTMLButtonElement>('[data-zone]').forEach((btn) => {
      const name = btn.dataset.name || '';
      btn.addEventListener('click', () => {
        if (state.selected.has(name)) {
          state.selected.delete(name);
          btn.setAttribute('aria-pressed', 'false');
        } else {
          state.selected.set(name, {
            einzel: Number(btn.dataset.einzel || 0),
            paket: Number(btn.dataset.paket || 0),
            btn,
          });
          btn.setAttribute('aria-pressed', 'true');
          if (!state.started) { state.started = true; (window as any).trackEvent?.('zonenwaehler_start'); }
        }
        updateLive();
      });
    });

    // --- Schritt 3: Modus ---
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.mode = btn.dataset.mode as 'paket' | 'einzel';
        root.querySelectorAll<HTMLElement>('[data-mode]').forEach((b) =>
          b.classList.toggle('is-active', b === btn)
        );
        updateLive();
      });
    });

    // --- Nav ---
    nextBtn?.addEventListener('click', () => {
      if (state.step === 1 && !state.gender) return;
      if (state.step === 2 && state.selected.size === 0) return;
      goTo(Math.min(4, state.step + 1));
    });
    backBtn?.addEventListener('click', () => goTo(Math.max(1, state.step - 1)));

    goTo(1);
  }
</script>
