---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource-variable/mulish';
import '@/styles/global.css';

import BaseHead from '@/components/BaseHead.astro';
import JsonLd from '@/components/JsonLd.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLdType?: 'home' | 'legal';
  breadcrumb?: { name: string; path: string }[];
}
const { title, description, path, jsonLdType = 'home', breadcrumb } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <BaseHead title={title} description={description} path={path} />
    <JsonLd type={jsonLdType} breadcrumb={breadcrumb} />
    {/* Cloudflare Turnstile (Spam-Schutz) – lädt nur, wenn ein Site-Key konfiguriert ist. */}
    {site.turnstileSiteKey && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}
    <noscript><style>.reveal{opacity:1 !important;transform:none !important;}</style></noscript>
    <script is:inline>
      // Consent-aware dataLayer. Es werden KEINE externen Skripte/Pixel automatisch geladen.
      // Ereignisse werden gepuffert und können später serverseitig ausgewertet werden.
      window.dataLayer = window.dataLayer || [];
      window.trackEvent = function (name, detail) {
        try {
          window.dataLayer.push(Object.assign({ event: name, ts: Date.now() }, detail || {}));
        } catch (e) {}
      };
    </script>
  </head>
  <body>
    <a href="#hauptinhalt" class="skip-link">Zum Inhalt springen</a>
    <slot />
    <ConsentBanner />

    <style>
      .skip-link {
        position: fixed;
        left: 1rem;
        top: -4rem;
        z-index: 100;
        background: var(--color-ink);
        color: var(--color-cream);
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius-sm);
        transition: top 0.2s ease;
        font-weight: 600;
      }
      .skip-link:focus {
        top: 1rem;
      }
    </style>

    <script>
      // Zentrales Klick-Tracking: jedes Element mit [data-track] feuert genau ein dataLayer-Event.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest('[data-track]');
        if (el) (window as any).trackEvent?.(el.getAttribute('data-track'));
      });
    </script>

    <script>
      // Animationen mit GSAP (lokal gebündelt, kein CDN). Respektiert prefers-reduced-motion.
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

      if (prefersReduced) {
        // Kein Motion: alles sofort sichtbar zeigen.
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        gsap.registerPlugin(ScrollTrigger);
        document.documentElement.classList.add('gsap-ready');

        const ease = 'power3.out';

        // 1) Hero-Intro als Timeline (beim Laden)
        const hero = document.querySelector('[data-hero]');
        if (hero) {
          const lines = hero.querySelectorAll('[data-hero-line]');
          const els = hero.querySelectorAll('[data-hero-el]');
          const tl = gsap.timeline({ defaults: { ease, duration: 0.9 } });
          if (lines.length) {
            tl.from(lines, { yPercent: 115, opacity: 0, stagger: 0.12 }, 0.1);
          }
          tl.from(els, { y: 28, opacity: 0, duration: 0.8, stagger: 0.09 }, 0.35);
        }

        // 2) Scroll-Reveal: einzelne Elemente sanft einblenden.
        //    Elemente mit gemeinsamem Elternteil werden gestaffelt (batch).
        ScrollTrigger.batch(revealEls, {
          start: 'top 86%',
          once: true,
          onEnter: (batch) =>
            gsap.fromTo(
              batch,
              { y: 30, opacity: 0 },
              { y: 0, opacity: 1, duration: 0.8, ease, stagger: 0.09, overwrite: true }
            ),
        });

        // Sicherheitsnetz: bereits sichtbare Elemente sofort zeigen.
        requestAnimationFrame(() => ScrollTrigger.refresh());
      }
    </script>
  </body>
</html>
