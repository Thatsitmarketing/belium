---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCta from '@/components/StickyCta.astro';
import TrustBar from '@/components/TrustBar.astro';

import Hero from '@/components/sections/Hero.astro';
import Problem from '@/components/sections/Problem.astro';
import Erlebnis from '@/components/sections/Erlebnis.astro';
import Vorteile from '@/components/sections/Vorteile.astro';
import MariaStudio from '@/components/sections/MariaStudio.astro';
import Geraet from '@/components/sections/Geraet.astro';
import Behandlungsvorschau from '@/components/sections/Behandlungsvorschau.astro';
import Ablauf from '@/components/sections/Ablauf.astro';
import ZonenPreise from '@/components/sections/ZonenPreise.astro';
import Bewertungen from '@/components/sections/Bewertungen.astro';
import FaqEignung from '@/components/sections/FaqEignung.astro';
import Kontakt from '@/components/sections/Kontakt.astro';

// SEO: Title <= 60 Zeichen, Description <= 155 Zeichen
const title = 'Laser Haarentfernung Gelsenkirchen Buer | Belium Beauty';
const description =
  'Dauerhafte Laser Haarentfernung in Gelsenkirchen Buer. Gekühlter VIKINI Diodenlaser, schmerzarm, zertifiziert. Jetzt kostenlose Beratung sichern.';
---
<Layout title={title} description={description} path="/">
  <span id="top"></span>
  <Header />
  <main id="hauptinhalt">
    <!-- 1. Hero: Was & warum, mit klarer CTA-Hierarchie -->
    <Hero />
    <!-- 2. Ruhige Vertrauensleiste (statisch, kein Laufband) -->
    <TrustBar />
    <!-- 3. Problem und gewünschtes Ergebnis -->
    <Problem />
    <!-- 4. Editorial-Erlebnisgalerie (horizontale Serif-Galerie) -->
    <Erlebnis />
    <!-- 5. Warum Belium – drei Säulen -->
    <Vorteile />
    <!-- 5. Wer behandelt: Maria & Studio (vor dem Preisrechner) -->
    <MariaStudio />
    <!-- 6. Gerät & Technik (Produkt-Showcase mit Punkte-Modul) -->
    <Geraet />
    <!-- 7. Behandlungsvorschau: Zonen auf einem Foto (Hotspots) -->
    <Behandlungsvorschau />
    <!-- 8. So funktioniert die Behandlung: Technik-Prinzipien + Ablauf -->
    <Ablauf />
    <!-- 9. Preisrechner (übergibt die Auswahl ans Kontaktformular) -->
    <ZonenPreise />
    <!-- 10. Kundenstimmen (ohne CTA) -->
    <Bewertungen />
    <!-- 11. Eignungscheck & FAQ -->
    <FaqEignung />
    <!-- 12. Einziger vollständiger Conversion-Bereich -->
    <Kontakt />
  </main>
  <Footer />
  <StickyCta />
</Layout>
