---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';

import Hero from '@/components/sections/Hero.astro';
import Problem from '@/components/sections/Problem.astro';
import Vorteile from '@/components/sections/Vorteile.astro';
import MariaStudio from '@/components/sections/MariaStudio.astro';
import Beratung from '@/components/sections/Beratung.astro';
import Geraet from '@/components/sections/Geraet.astro';
import Behandlungsvorschau from '@/components/sections/Behandlungsvorschau.astro';
import Ablauf from '@/components/sections/Ablauf.astro';
import Bewertungen from '@/components/sections/Bewertungen.astro';
import FaqEignung from '@/components/sections/FaqEignung.astro';
import Kontakt from '@/components/sections/Kontakt.astro';

// SEO: Title <= 60 Zeichen, Description <= 155 Zeichen
const title = 'Laser Haarentfernung Gelsenkirchen Buer | Belium Beauty';
const description =
  'Dauerhafte Laser Haarentfernung in Gelsenkirchen Buer. Gekühlter Diodenlaser, schmerzarm, zertifiziert. Jetzt kostenlose Beratung sichern.';
---
<Layout title={title} description={description} path="/">
  <span id="top"></span>
  <ScrollProgress />
  <Header />
  <main id="hauptinhalt">
    <!-- 1. Hero: Was & warum, mit klarer CTA-Hierarchie -->
    <Hero />
    <!-- 2. Problem und gewünschtes Ergebnis -->
    <Problem />
    <!-- 3. Einzelberatung: was im Gespräch mit Maria passiert – überzeugt früh
         und trennt zugleich die beiden hellen Abschnitte optisch voneinander -->
    <Beratung />
    <!-- 4. Warum Belium: drei Säulen -->
    <Vorteile />
    <!-- 5. Wer behandelt: Maria & Studio -->
    <MariaStudio />
    <!-- 6. Gerät & Technik (Produkt-Showcase mit Punkte-Modul) -->
    <Geraet />
    <!-- 7. Behandlungsvorschau: Zonen auf einem Foto (Hotspots) -->
    <Behandlungsvorschau />
    <!-- 8. So funktioniert die Behandlung: Technik-Prinzipien + Ablauf -->
    <Ablauf />
    <!-- 9. Kundenstimmen (ohne CTA) -->
    <Bewertungen />
    <!-- 10. Eignungscheck & FAQ -->
    <FaqEignung />
    <!-- 11. Einziger vollständiger Conversion-Bereich: Kontaktformular -->
    <Kontakt />
  </main>
  <Footer />
</Layout>
